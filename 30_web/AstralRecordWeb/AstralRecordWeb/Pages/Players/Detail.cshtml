@page "/players/{userUuid:guid}"
@model AstralRecordWeb.Pages.Players.DetailModel
@{ ViewData["Title"] = Model.Profile is { } p ? $"{p.Mcid} のプロフィール" : "プレイヤー情報"; ViewData["OwnProfile"] = false; }
<section class="ar-portal">
    <div class="container">
        <header class="ar-portal-heading"><div><p class="ar-portal-eyebrow">プレイヤーの冒険の記録</p><h1>プレイヤープロフィール</h1><p class="ar-portal-sub">@(Model.Profile?.Mcid) のアカウント情報を表示しています。</p></div><a class="btn ar-btn-outline" asp-page="/Players/Index" asp-route-mcid="@Model.Mcid" asp-route-classId="@Model.ClassId" asp-route-sort="@Model.Sort" asp-route-pageNumber="@Model.PageNumber" asp-route-includePrivate="@Model.IncludePrivate">プレイヤー一覧へ</a></header>
        @if (Model.IsPrivateView) { <div class="alert alert-warning">このプロフィールは非公開です。閲覧権限のあるユーザーにのみ表示されています。</div> }
        @if (Model.ErrorMessage is not null) { <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div> }
        @if (Model.Profile is { } profile)
        {
            @if (profile.Accounts.Count > 0)
            {
                <form method="get" class="ar-panel ar-account-picker" aria-label="表示アカウントの選択">
                    <input type="hidden" name="mcid" value="@Model.Mcid" /><input type="hidden" name="classId" value="@Model.ClassId" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="pageNumber" value="@Model.PageNumber" /><input type="hidden" name="includePrivate" value="@Model.IncludePrivate.ToString().ToLowerInvariant()" />
                    <label for="account-select">表示するアカウント</label>
                    <select id="account-select" name="accountId" disabled="@(profile.Accounts.Count <= 1)" onchange="this.form.submit()">
                        @foreach (var account in profile.Accounts) { <option value="@account.AccountId" selected="@(profile.CurrentAccount?.AccountId == account.AccountId)">スロット @account.SlotIndex: @account.AccountName（Lv. @account.PlayerLevel / @account.ClassName）</option> }
                    </select>
                    <button type="submit" class="btn ar-btn-outline" disabled="@(profile.Accounts.Count <= 1)">表示する</button>
                    <p>閲覧するアカウントだけを切り替えます。</p>
                </form>
            }
            <partial name="_PlayerProfile" model="profile" />
            @if (Model.IsWebAdmin)
            {
                <section class="ar-panel ar-ban-management" aria-labelledby="ban-management-title" data-ban-management data-target-mcid="@profile.Mcid" data-target-uuid="@profile.UserUuid">
                    <h2 id="ban-management-title">管理者操作: 利用停止</h2>
                    <p class="ar-portal-sub">アカウントではなく、このプレイヤーの User UUID 全体に適用します。</p>
                    @if (Model.BanErrorMessage is not null) { <div class="ar-alert" role="alert">@Model.BanErrorMessage</div> }
                    @if (Model.BanState is { } ban)
                    {
                        <dl class="ar-ban-state"><div><dt>現在の状態</dt><dd>@(ban.IsActive ? "利用停止中" : "利用可能")</dd></div><div><dt>対象 UUID</dt><dd>@ban.UserUuid</dd></div><div><dt>期限</dt><dd>@(ban.IsActive ? (ban.IsIndefinite ? "無期限" : ban.ExpiresAtUtc?.ToOffset(TimeSpan.FromHours(9)).ToString("yyyy/MM/dd HH:mm zzz") ?? "未設定") : "—")</dd></div></dl>
                        <form method="post" asp-page-handler="Ban" asp-route-mcid="@Model.Mcid" asp-route-classId="@Model.ClassId" asp-route-sort="@Model.Sort" asp-route-pageNumber="@Model.PageNumber" asp-route-includePrivate="@Model.IncludePrivate" asp-route-accountId="@Model.AccountId" class="ar-ban-editor" data-ban-editor>
                            <input type="hidden" name="BanInput.ExpectedRevision" value="@ban.Revision" />
                            <label><input type="radio" name="BanInput.IsBanned" value="true" checked="@Model.BanInput.IsBanned" data-ban-mode="ban" />利用停止にする</label>
                            <label><input type="radio" name="BanInput.IsBanned" value="false" checked="@(!Model.BanInput.IsBanned)" data-ban-mode="unban" />解除する</label>
                            <div data-ban-fields>
                                <label><input name="BanInput.IsIndefinite" type="checkbox" value="true" checked="@Model.BanInput.IsIndefinite" data-ban-indefinite />無期限</label>
                                <fieldset class="ar-ban-expiry" data-ban-expiry-fields>
                                    <legend>解除日時（日本時間）</legend>
                                    <div class="ar-ban-date-row">
                                        <label>日付<input name="BanInput.ExpiresOn" type="date" value="@Model.BanInput.ExpiresOn" data-ban-date /></label>
                                        <label>時刻<input name="BanInput.ExpiresTime" type="time" value="@Model.BanInput.ExpiresTime" step="60" data-ban-time /></label>
                                        <button type="button" class="btn ar-btn-outline" data-ban-calendar>カレンダーを開く</button>
                                    </div>
                                    <div class="ar-ban-presets" aria-label="解除日時をまとめて設定">
                                        <button type="button" class="btn ar-btn-outline" data-ban-days="1">1日後</button>
                                        <button type="button" class="btn ar-btn-outline" data-ban-days="7">7日後</button>
                                        <button type="button" class="btn ar-btn-outline" data-ban-days="30">30日後</button>
                                    </div>
                                </fieldset>
                                <label>理由<textarea name="BanInput.Reason" maxlength="500" rows="3" data-ban-reason>@Model.BanInput.Reason</textarea></label>
                            </div>
                            <button type="button" class="btn ar-btn-primary" data-ban-open>内容を確認する</button>
                        </form>
                        <dialog class="ar-confirm" data-ban-confirm aria-labelledby="ban-confirm-title">
                            <span class="ar-confirm-icon" aria-hidden="true">◇</span><h2 id="ban-confirm-title">利用停止の内容を確認</h2>
                            <dl class="ar-ban-confirm"><div><dt>対象</dt><dd data-ban-confirm-target></dd></div><div><dt>UUID</dt><dd data-ban-confirm-uuid></dd></div><div><dt>操作</dt><dd data-ban-confirm-action></dd></div><div><dt>期限</dt><dd data-ban-confirm-expiry></dd></div><div><dt>理由</dt><dd data-ban-confirm-reason></dd></div></dl>
                            <div class="ar-confirm-actions"><button type="button" class="btn ar-btn-outline" data-ban-cancel autofocus>キャンセル</button><button type="button" class="btn ar-btn-primary" data-ban-submit>確定する</button></div>
                        </dialog>
                    }
                </section>
            }
        }
    </div>
</section>
@section Scripts { <script type="module" src="~/js/skilltree-viewer.js" asp-append-version="true"></script><script src="~/js/network-admin.js" asp-append-version="true"></script> }
