@page
@model AstralRecordWeb.Pages.Market.IndexModel
@{
    ViewData["Title"] = "マーケット";
    var buyer = Model.SelectedBuyerAccount;
}
<link rel="stylesheet" href="~/css/market.css" asp-append-version="true" />

<section class="ar-portal market-page market-browse">
    <div class="container">
        <header class="ar-portal-heading">
            <div>
                <p class="ar-portal-eyebrow">ASTRAL EXCHANGE</p>
                <h1>マーケット<span class="market-title-dot" aria-hidden="true">.</span></h1>
                <p class="ar-portal-sub">冒険に必要な一品を、プレイヤーから。</p>
            </div>
            <a class="btn ar-btn-outline market-history-link" asp-page="/Market/History">取引履歴を見る <span aria-hidden="true">↗</span></a>
        </header>

        <section class="market-wallet" aria-labelledby="market-wallet-title">
            <div class="market-wallet-balance">
                <span class="market-wallet-icon" aria-hidden="true">G</span>
                <div>
                    <h2 id="market-wallet-title">現在の所持金</h2>
                    <p class="market-wallet-amount">@(Model.BuyerGold?.ToString("N0") ?? "—") <span>Gold</span></p>
                    <p class="market-wallet-note">@(buyer is null ? "購入にはゲーム内アカウントが必要です。" : Model.BuyerGold.HasValue ? "ゲーム内の保存済み残高です。購入時に再確認されます。" : "所持金を取得できませんでした。再読み込みしてください。")</p>
                </div>
            </div>
            @if (buyer is not null)
            {
                <form method="get" class="market-account-form">
                    @foreach (var parameter in Model.PreservedSearchParameters())
                    {
                        <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
                    }
                    <label for="market-buyer-account">購入・受け取りに使うアカウント</label>
                    <div class="market-account-controls">
                        <select id="market-buyer-account" name="BuyerAccountId">
                            @foreach (var account in Model.BuyerAccounts)
                            {
                                <option value="@account.Uuid" selected="@(account.Uuid == Model.BuyerAccountId)">@account.AccountName #@account.SlotIndex</option>
                            }
                        </select>
                        <button type="submit" class="btn ar-btn-outline">切り替え・更新</button>
                    </div>
                    <p class="market-wallet-note">購入品はこのアカウントのゲーム内メールへ届きます。</p>
                </form>
            }
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.PurchaseMessage))
        {
            <div class="alert alert-info" role="status">@Model.PurchaseMessage</div>
        }
        <div class="market-workspace">
            <aside class="market-sidebar" aria-label="検索条件">
                <details class="market-filter-disclosure" data-market-filters open>
                    <summary>検索条件を変更<span>名前・カテゴリ・価格で絞り込み</span></summary>
                <form method="get" class="ar-panel market-search" role="search" aria-label="マーケット検索条件" data-market-search>
                    <input type="hidden" name="BuyerAccountId" value="@Model.BuyerAccountId" />
                    <div class="market-search-heading">
                        <div><p class="ar-portal-eyebrow">FIND YOUR ITEM</p><h2>絞り込み</h2></div>
                        <a asp-page="/Market/Index" asp-route-BuyerAccountId="@Model.BuyerAccountId" class="market-reset">クリア</a>
                    </div>
                    <div class="market-filter-grid">
                        <div class="market-filter-wide"><label asp-for="Query">アイテムを検索</label><input asp-for="Query" placeholder="名前・ID・説明から探す" autocomplete="off" /></div>
                        <div><label asp-for="Category">カテゴリ</label><select asp-for="Category"><option value="">すべてのカテゴリ</option>@foreach (var value in Model.Categories) { <option value="@value">@value</option> }</select></div>
                        <div><label asp-for="Rarity">レアリティ</label><select asp-for="Rarity"><option value="">すべてのレアリティ</option>@foreach (var value in Model.Rarities) { <option value="@value">@value</option> }</select></div>
                        <div><label asp-for="EquipmentSlot">装備スロット</label><select asp-for="EquipmentSlot"><option value="">すべてのスロット</option>@foreach (var value in Model.EquipmentSlots) { <option value="@value">@value</option> }</select></div>
                        <div><label asp-for="Sort">並び順</label><select asp-for="Sort"><option value="newest">新着順</option><option value="price_asc">単価が低い順</option><option value="price_desc">単価が高い順</option></select></div>
                    </div>
                    <div class="market-range-grid">
                        <fieldset><legend>単価</legend><div class="market-range"><input asp-for="MinimumPrice" aria-label="単価の下限" type="number" min="0" placeholder="下限" /><span>〜</span><input asp-for="MaximumPrice" aria-label="単価の上限" type="number" min="0" placeholder="上限" /></div></fieldset>
                        <fieldset><legend>必要レベル</legend><div class="market-range"><input asp-for="RequiredLevelMin" aria-label="必要レベルの下限" type="number" min="0" placeholder="下限" /><span>〜</span><input asp-for="RequiredLevelMax" aria-label="必要レベルの上限" type="number" min="0" placeholder="上限" /></div></fieldset>
                    </div>
                    @if (Model.NumericFilters.Count > 0)
                    {
                        <details class="market-advanced">
                            <summary>性能値でさらに絞り込む</summary>
                            <div class="market-numeric-filters">
                                @foreach (var filter in Model.NumericFilters)
                                {
                                    <label>@filter.Label <small>@filter.Minimum.ToString("0.####") 〜 @filter.Maximum.ToString("0.####")</small>
                                        <span class="market-range"><input name="@Model.NumericMinimumName(filter)" aria-label="@(filter.Label + " の下限")" type="number" step="any" placeholder="下限" value="@ViewContext.HttpContext.Request.Query[Model.NumericMinimumName(filter)]" /><span>〜</span><input name="@Model.NumericMaximumName(filter)" aria-label="@(filter.Label + " の上限")" type="number" step="any" placeholder="上限" value="@ViewContext.HttpContext.Request.Query[Model.NumericMaximumName(filter)]" /></span>
                                    </label>
                                }
                            </div>
                        </details>
                    }
                    <div class="market-search-actions"><button type="submit" class="btn ar-btn-primary">この条件で検索</button></div>
                </form>
                </details>
                <div class="market-guide"><span aria-hidden="true">✉</span><div><strong>購入後はメールで受け取り</strong><p>ゲームにログイン中は、保存処理のあとに購入が確定します。</p></div></div>
            </aside>

            <div class="market-results">
                <div class="market-results-heading">
                    <div><p class="ar-portal-eyebrow">ACTIVE LISTINGS</p><h2>出品一覧 <span>@Model.Listings.Count.ToString("N0")<small>件</small></span></h2></div>
                    <p class="ar-portal-sub">全 @Model.TotalListingCount.ToString("N0") 件から表示</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
                }
                else if (Model.Listings.Count == 0)
                {
                    <div class="ar-empty market-empty"><span aria-hidden="true">◇</span><h3>出品が見つかりませんでした</h3><p>検索する名前や条件を変えてお試しください。</p><a asp-page="/Market/Index" asp-route-BuyerAccountId="@Model.BuyerAccountId">すべての出品を見る</a></div>
                }
                else
                {
                    <div class="market-list">
                        @foreach (var entry in Model.Listings)
                        {
                            var listing = entry.Listing;
                            var equipment = entry.EquipmentInstance;
                            var isOwn = Model.IsOwnListing(listing);
                            var currency = IndexModel.CurrencyLabel(listing.CurrencyId);
                            var recommendedPrice = entry.RecommendedUnitPrice;
                            <article class="ar-item-card market-card rarity-@((entry.Rarity ?? "common").ToLowerInvariant())">
                                <div class="market-item-overview">
                                    <div class="ar-item-head">
                                        <div class="ar-item-icon" aria-hidden="true"><img data-market-icon="@entry.Item?.Icon" alt="" hidden /><span data-market-icon-fallback>✦</span></div>
                                        <div class="ar-item-title-block">
                                            <div class="ar-item-tags">@if (!string.IsNullOrWhiteSpace(entry.Rarity)) { <span class="ar-rarity">@entry.Rarity</span> }<span>@entry.Category</span>@if (isOwn) { <span class="market-own-tag">自分の出品</span> }</div>
                                            <div class="market-card-title-row"><h3 class="ar-item-name">@entry.DisplayName</h3>@if (equipment is { EnhanceLevel: > 0 }) { <strong class="market-enhance">+@equipment.EnhanceLevel</strong> }</div>
                                            <p class="market-item-meta">@IndexModel.InstanceTypeLabel(listing.InstanceType) @if (entry.RequiredLevel.HasValue) { <span>· 必要Lv. @entry.RequiredLevel</span> } @if (!string.IsNullOrWhiteSpace(entry.EquipmentSlot)) { <span>· @entry.EquipmentSlot</span> }</p>
                                        </div>
                                    </div>
                                    <div class="market-seller">
                                        <span class="market-seller-icon" aria-hidden="true">♙</span><span>出品者</span>
                                        @if (listing.SellerUserUuid is { } sellerUuid)
                                        {
                                            <a asp-page="/Players/Detail" asp-route-userUuid="@sellerUuid" asp-route-accountId="@listing.SellerAccountId">@Model.SellerName(listing)<span aria-hidden="true"> ↗</span></a>
                                        }
                                        else { <strong>@Model.SellerName(listing)</strong> }
                                    </div>
                                    @if (entry.DisplayLore.Count > 0) { <p class="market-item-lore">@entry.DisplayLore.First()</p> }
                                    @if (equipment is not null)
                                    {
                                        <div class="market-instance-facts" aria-label="個体性能の要約"><span>強化 <strong>+@equipment.EnhanceLevel</strong></span><span>超越 <strong>@equipment.TranscendenceRank</strong></span><span>ルーン <strong>@equipment.Runes.Count / @equipment.RuneMaxSlots</strong></span></div>
                                        @if (equipment.StatRolls.Count > 0)
                                        {
                                            <div class="ar-item-block market-instance-summary"><ul>@foreach (var stat in equipment.StatRolls.OrderBy(stat => stat.SortOrder).Take(3)) { <li><span>@stat.Status</span><strong>@IndexModel.InstanceStatText(stat)</strong><em>個体値</em></li> }</ul></div>
                                        }
                                    }
                                    else if (listing.InstanceId.HasValue)
                                    {
                                        <p class="market-instance-missing">個体性能情報を取得できませんでした。購入前に再読み込みしてください。</p>
                                    }
                                    <p class="market-listing-time">出品 @DateTime.SpecifyKind(listing.ListedAt, DateTimeKind.Utc).AddHours(9).ToString("MM/dd HH:mm") <span>· 期限 @DateTime.SpecifyKind(listing.ExpiresAt, DateTimeKind.Utc).AddHours(9).ToString("MM/dd HH:mm")（日本時間）</span></p>
                                </div>
                                <div class="market-purchase-panel">
                                    <div class="market-price"><span>出品価格（1個あたり）</span><p><strong>@listing.UnitPrice.ToString("N0")</strong> <em>@currency</em></p></div>
                                    <p class="market-recommended-price"><span>おすすめ価格（出品時点の参考価格）</span><strong>@(recommendedPrice?.ToString("N0") ?? "データなし")</strong>@if (recommendedPrice.HasValue) { <small>@currency</small> }</p>
                                    <p class="market-stock">在庫 <strong>@listing.RemainingQuantity.ToString("N0")</strong> 個</p>
                                    @if (buyer is not null && !isOwn)
                                    {
                                        <form method="post" asp-page-handler="Purchase" class="market-purchase-form" data-market-purchase
                                              data-unit-price="@listing.UnitPrice" data-gold="@(Model.BuyerGold?.ToString(System.Globalization.CultureInfo.InvariantCulture))" data-currency="@currency">
                                            <input type="hidden" name="ListingId" value="@listing.ListingId" />
                                            <input type="hidden" name="OperationId" value="@Guid.NewGuid()" />
                                            <input type="hidden" name="BuyerAccountId" value="@buyer.Uuid" />
                                            <label for="quantity-@listing.ListingId">購入数量</label>
                                            <input id="quantity-@listing.ListingId" name="PurchaseQuantity" type="number" min="1" step="1"
                                                   max="@(listing.InstanceId.HasValue ? 1 : Math.Min(listing.RemainingQuantity, int.MaxValue))"
                                                   value="1" readonly="@listing.InstanceId.HasValue" required />
                                            <div class="market-total"><span>支払合計</span><strong data-purchase-total>@listing.UnitPrice.ToString("N0") @currency（1個）</strong></div>
                                            <p class="market-balance-after" data-purchase-balance aria-live="polite">数量を変更すると合計を確認できます。</p>
                                            <button type="submit" class="btn ar-btn-primary market-buy-button">購入する <span aria-hidden="true">→</span></button>
                                            <p class="market-purchase-account">受取先：@buyer.AccountName #@buyer.SlotIndex</p>
                                        </form>
                                    }
                                    else
                                    {
                                        <p class="market-purchase-unavailable">@(isOwn ? "選択中のアカウントの出品です" : "購入用アカウントがありません")</p>
                                    }
                                </div>
                            <details class="market-details">
                                <summary>性能・出品の詳細を見る</summary>
                                <div class="market-detail-grid">
                                    <section><h3>出品情報</h3><dl class="ar-item-data"><dt>アイテムID</dt><dd>@listing.ItemId</dd><dt>出品時の総額</dt><dd>@listing.TotalPrice.ToString("N0") @listing.CurrencyId</dd><dt>出品日時</dt><dd>@DateTime.SpecifyKind(listing.ListedAt, DateTimeKind.Utc).AddHours(9).ToString("yyyy/MM/dd HH:mm")</dd><dt>期限</dt><dd>@DateTime.SpecifyKind(listing.ExpiresAt, DateTimeKind.Utc).AddHours(9).ToString("yyyy/MM/dd HH:mm")</dd><dt>出品価格（1個あたり）</dt><dd>@listing.UnitPrice.ToString("N0") @currency</dd><dt>おすすめ価格（出品時点の参考価格）</dt><dd>@(recommendedPrice?.ToString("N0") ?? "データなし") @if (recommendedPrice.HasValue) { @currency }</dd></dl></section>
                                    <section><h3>基礎アイテム情報</h3><dl class="ar-item-data"><dt>レアリティ</dt><dd>@(entry.Rarity ?? "—")</dd><dt>必要レベル</dt><dd>@(entry.RequiredLevel?.ToString() ?? "—")</dd><dt>売却価格</dt><dd>@(entry.Item?.SaleValue.ToString("N0") ?? "—")</dd><dt>スタック</dt><dd>@(entry.Item?.MaxStack.ToString() ?? "—")</dd></dl>@if (entry.Item?.Equipment?.Stats.Count > 0) { <div class="ar-item-block"><h3>基礎性能の範囲</h3><ul>@foreach (var stat in entry.Item.Equipment.Stats) { <li><span>@stat.Status</span><strong>@Model.ItemStatText(stat)</strong><em>@stat.Type</em></li> }</ul></div> }</section>
                                </div>
                                @if (equipment is not null)
                                {
                                    <div class="market-detail-grid market-instance-details">
                                        <section><h3>個体状態</h3><dl class="ar-item-data"><dt>強化値</dt><dd>+@equipment.EnhanceLevel</dd><dt>超越ランク</dt><dd>@equipment.TranscendenceRank</dd><dt>耐久値</dt><dd>@(equipment.DurabilityValue?.ToString() ?? "—") / @(equipment.DurabilityMax?.ToString() ?? "—")</dd><dt>ルーン枠</dt><dd>@equipment.Runes.Count / @equipment.RuneMaxSlots</dd></dl></section>
                                        <section><h3>ランダム個体値</h3>@if (equipment.StatRolls.Count == 0) { <p class="ar-portal-sub">ランダム個体値はありません。</p> } else { <div class="ar-item-block"><ul>@foreach (var stat in equipment.StatRolls.OrderBy(stat => stat.SortOrder)) { <li><span>@stat.Status</span><strong>@IndexModel.InstanceStatText(stat)</strong><em>個体値</em></li> }</ul></div> }</section>
                                        <section><h3>エンチャント</h3>@if (equipment.Enchants.Count == 0) { <p class="ar-portal-sub">未付与</p> } else { <div class="ar-item-block"><ul>@foreach (var enchant in equipment.Enchants.OrderBy(enchant => enchant.SlotIndex)) { <li><span>@enchant.Status</span><strong>@enchant.Value.ToString("0.####")</strong><em>@enchant.Type</em></li> }</ul></div> }</section>
                                        <section><h3>装着ルーン</h3>@if (equipment.Runes.Count == 0) { <p class="ar-portal-sub">未装着</p> } else { <div class="ar-item-block"><ul>@foreach (var rune in equipment.Runes.OrderBy(rune => rune.SlotIndex)) { <li><span>スロット @(rune.SlotIndex + 1)</span><strong>@rune.ItemId</strong><em>ルーン</em></li> }</ul></div> }</section>
                                    </div>
                                }
                            </details>

                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/market-icons.js" asp-append-version="true"></script>
    <script type="module" src="~/js/market-purchase.mjs" asp-append-version="true"></script>
}
