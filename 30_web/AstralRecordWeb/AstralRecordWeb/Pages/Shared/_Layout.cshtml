<!DOCTYPE html>
<html lang="ja">
@inject Microsoft.Extensions.Options.IOptions<AstralRecordWeb.Options.PublicSiteOptions> PublicSiteOptionsAccessor
@{
    var publicSite = PublicSiteOptionsAccessor.Value;
    var metaDescription = publicSite.IsOpenAlpha
        ? "Minecraft RPGサーバー Astral Record。Java版オープンアルファ公開中。"
        : "Minecraft RPGサーバー Astral Record。クラス、スキル、装備を組み合わせて冒険しよう。";
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@metaDescription" />
    <title>@ViewData["Title"] - Astral Record</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AstralRecordWeb.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Noto+Sans+JP:wght@300;400;700&display=swap" rel="stylesheet" />
</head>
<body>
    <a class="ar-skip-link" href="#main-content">本文へ移動</a>
    <nav class="navbar navbar-expand-lg ar-navbar fixed-top">
        <div class="container">
            <a class="navbar-brand ar-brand" asp-area="" asp-page="/Index">
                <img src="~/images/icon.png" srcset="/images/icon-128.webp 128w, /images/icon-256.webp 256w"
                     sizes="40px" width="128" height="128" alt="Astral Record" class="ar-brand-icon" />
                <span class="ar-brand-text">Astral Record</span>
                @if (publicSite.IsOpenAlpha)
                {
                    <span class="ar-brand-alpha">OPEN ALPHA</span>
                }
            </a>
            <button class="navbar-toggler ar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link ar-nav-link" asp-area="" asp-page="/Index">ホーム</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ar-nav-link" asp-area="" asp-page="/Index" asp-fragment="features">特徴</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ar-nav-link" asp-area="" asp-page="/Index" asp-fragment="join">参加情報</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ar-nav-link" asp-area="" asp-page="/Releases/Index">お知らせ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ar-nav-link" asp-area="" asp-page="/Terms">利用規約</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ar-nav-link" asp-area="" asp-page="/Privacy">プライバシーポリシー</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var hasAdminPermission = int.TryParse(User.FindFirst("permission")?.Value, out var permission)
                            && permission >= 99;
                        if (hasAdminPermission)
                        {
                            <li class="nav-item">
                                <a class="nav-link ar-nav-link" asp-area="" asp-page="/Admin/Items">アイテム</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link ar-nav-link" asp-area="" asp-page="/MyPage">マイページ</a>
                        </li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Logout" class="d-inline">
                                <button type="submit" class="nav-link ar-nav-link btn btn-link p-0">ログアウト</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link ar-nav-link ar-nav-login" asp-area="" asp-page="/Login">ログイン<span>未実装</span></a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main id="main-content">
        @RenderBody()
    </main>

    <footer class="ar-footer">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-md-4 text-center text-md-start">
                    <img src="~/images/icon.png" srcset="/images/icon-128.webp 128w, /images/icon-256.webp 256w"
                         sizes="48px" width="128" height="128" alt="Astral Record" class="ar-footer-icon" />
                </div>
                <div class="col-md-4 text-center">
                    <p class="ar-footer-title mb-1">Astral Record</p>
                    <p class="ar-footer-sub mb-0">Minecraft Java Edition MMO RPG</p>
                </div>
                <div class="col-md-4 text-center text-md-end">
                    <div class="ar-footer-links">
                        <a asp-page="/Index">ホーム</a>
                        <span class="mx-2 opacity-50">|</span>
                        <a asp-page="/Index" asp-fragment="join">参加情報</a>
                        <span class="mx-2 opacity-50">|</span>
                        <a asp-page="/Terms">利用規約</a>
                        <span class="mx-2 opacity-50">|</span>
                        <a asp-page="/Privacy">プライバシーポリシー</a>
                        <span class="mx-2 opacity-50">|</span>
                        <a href="https://discord.gg/Fja6zmpjGX" target="_blank" rel="noopener noreferrer"
                           aria-label="Astral Record公式Discordを新しいタブで開く">Discord</a>
                    </div>
                </div>
            </div>
            <hr class="ar-footer-hr" />
            <p class="ar-footer-copy text-center mb-0">&copy; 2026 Astral Record. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
