<!DOCTYPE html>
<html lang="ja">
@inject Microsoft.Extensions.Options.IOptions<AstralRecordWeb.Options.PublicSiteOptions> PublicSiteOptionsAccessor
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@inject AstralRecordWeb.Services.DonationApiClient DonationApi
@using System.Security.Claims
@{
    var publicSite = PublicSiteOptionsAccessor.Value;
    var pagePath = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    var isHomePage = string.Equals(pagePath, "/Index", StringComparison.OrdinalIgnoreCase);
    var isAdminPage = pagePath.StartsWith("/Admin/", StringComparison.OrdinalIgnoreCase)
        || string.Equals(pagePath, "/Players/Vip", StringComparison.OrdinalIgnoreCase);
    var isReleasePage = pagePath.StartsWith("/Releases/", StringComparison.OrdinalIgnoreCase);
    var isPublicPage = isHomePage || isReleasePage || pagePath is "/Terms" or "/Privacy" or "/Login";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var metaDescription = publicSite.IsOpenAlpha
        ? "Minecraft RPGサーバー Astral Record。Java版オープンアルファ公開中。"
        : "Minecraft RPGサーバー Astral Record。クラス、スキル、装備を組み合わせて冒険しよう。";
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@metaDescription" />
    <meta name="theme-color" content="#1e1c17" />
    <title>@ViewData["Title"] - Astral Record</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AstralRecordWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/skilltree.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/journal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/astral-motion.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @if (isAdminPage)
    {
        <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    }
    else if (!isPublicPage)
    {
        <link rel="stylesheet" href="~/css/player.css" asp-append-version="true" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@500;600&display=swap" rel="stylesheet" />
</head>
<body class="ar-journal @(isHomePage ? "ar-journal--home" : "ar-journal--inner") @(isAdminPage ? "ar-admin" : isPublicPage ? "ar-public" : "ar-player")">
    <a class="ar-skip-link" href="#main-content">本文へ移動</a>
    <nav class="navbar ar-navbar fixed-top" aria-label="メインナビゲーション">
        <div class="container ar-navbar-inner">
            <a class="navbar-brand ar-brand" asp-page="/Index" aria-label="Astral Record ホーム"
               aria-current="@(isHomePage ? "page" : null)">
                <img src="~/images/icon-128.webp" width="36" height="36" alt="" class="ar-brand-icon" />
                <span class="ar-brand-text">Astral Record</span>
            </a>
            <div class="ar-nav-explore">
                <a asp-page="/Index" asp-fragment="features">ゲーム紹介</a>
                <a asp-page="/Releases/Index" aria-current="@(isReleasePage ? "page" : null)">お知らせ</a>
                @if (signedIn)
                {
                    <a asp-page="/MyPage" aria-current="@(pagePath == "/MyPage" ? "page" : null)">マイページ</a>
                }
                else
                {
                    <a asp-page="/Login" aria-current="@(pagePath == "/Login" ? "page" : null)">ログイン</a>
                }
            </div>
            <a class="ar-plate ar-nav-join" asp-page="/Index" asp-fragment="join">参加方法</a>
            @if (signedIn)
            {
                <button class="ar-menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#site-menu"
                        aria-controls="site-menu" aria-expanded="false" aria-label="プレイヤーメニュー">
                    <span class="ar-menu-lines" aria-hidden="true"><i></i><i></i></span><span>メニュー</span>
                </button>
            }
        </div>
    </nav>
    @if (signedIn)
    {
        <div class="offcanvas offcanvas-end ar-menu" tabindex="-1" id="site-menu" aria-labelledby="site-menu-title">
            <div class="offcanvas-header">
                <div>
                    <h2 class="offcanvas-title" id="site-menu-title">プレイヤーメニュー</h2>
                    <span class="ar-menu-player">@User.Identity?.Name</span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="メニューを閉じる"></button>
            </div>
            <div class="offcanvas-body">
                <nav class="ar-menu-section" aria-label="ゲーム">
                    <p class="ar-menu-label">ゲーム</p>
                    <a asp-page="/Bestiary/Index">討伐モブ図鑑</a>
                    <a asp-page="/Players/Index">プレイヤー一覧</a>
                    <a asp-page="/Market/Index">マーケット</a>
                </nav>
                <nav class="ar-menu-section" aria-label="アカウント">
                    <p class="ar-menu-label">アカウント</p>
                    <a asp-page="/Mail/Index">メール</a>
                    <a asp-page="/AstraldShop/Index">有償アストラルドショップ</a>
                    <a asp-page="/Donations/Index">寄付フォーム・履歴</a>
                    <a asp-page="/LoginSettings">ログイン設定</a>
                </nav>
                @{
                    var webAdminAuthorization = await AuthorizationService.AuthorizeAsync(User, resource: null, policyName: "WebAdminVisible");
                }
                @if (webAdminAuthorization.Succeeded)
                {
                    var pendingDonationCount = 0;
                    var verifiedAdmin = await AuthorizationService.AuthorizeAsync(User, Context, "WebAdminOnly");
                    if (verifiedAdmin.Succeeded && Guid.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var actor))
                    {
                        var countResult = await DonationApi.PendingCountAsync(actor, Context.RequestAborted);
                        if (countResult.Succeeded) pendingDonationCount = countResult.Value!.PendingCount;
                    }
                    <nav class="ar-menu-section" aria-label="管理者専用">
                        <p class="ar-menu-label">管理者専用</p>
                        <a asp-page="/Admin/Donations/Index">
                            <span>寄付申請管理</span>
                            @if (pendingDonationCount > 0)
                            {
                                <span class="ar-menu-badge"><span class="visually-hidden">申請中 </span>@pendingDonationCount<span class="visually-hidden">件</span></span>
                            }
                        </a>
                        <a asp-page="/Admin/Items">アイテム</a>
                        <a asp-page="/Admin/Network">ネットワーク設定</a>
                        <a asp-page="/Admin/Defense">防衛戦管理</a>
                        <a asp-page="/Admin/History/SameIp">プレイヤー活動履歴</a>
                        <a asp-page="/Players/Vip">VIPプレイヤー一覧</a>
                    </nav>
                }
                <a class="ar-menu-logout" asp-page="/Logout" data-logout-open>ログアウト</a>
            </div>
        </div>
        <dialog class="ar-confirm" id="logout-confirm" aria-labelledby="logout-title" aria-describedby="logout-description">
            <h2 id="logout-title">ログアウトしますか？</h2>
            <p id="logout-description">現在の Web セッションを終了します。</p>
            <div class="ar-confirm-actions">
                <button type="button" class="btn ar-btn-outline" data-logout-cancel autofocus>キャンセル</button>
                <form method="post" asp-page="/Logout">
                    <button type="submit" class="btn ar-btn-primary">ログアウトする</button>
                </form>
            </div>
        </dialog>
    }

    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="ar-footer" aria-label="Astral Record">
        <div class="container">
            <div class="ar-footer-bottom">
                <div>
                    <a class="ar-footer-wordmark" asp-page="/Index">Astral Record</a>
                    <p class="ar-footer-sub mb-0">Minecraft RPG サーバー</p>
                </div>
                <nav class="ar-footer-links" aria-label="フッターナビゲーション">
                        <a asp-page="/Index" asp-fragment="join">参加方法</a>
                        <a asp-page="/Terms">利用規約</a>
                        <a asp-page="/Privacy">プライバシーポリシー</a>
                        <a href="https://discord.gg/Fja6zmpjGX" target="_blank" rel="noopener noreferrer"
                           aria-label="Astral Record公式Discordを新しいタブで開く">公式Discord</a>
                </nav>
            </div>
            <div class="ar-footer-meta">
                <p class="ar-footer-copy mb-0">&copy; 2026 Astral Record</p>
                <p class="ar-video-credit">背景映像：<a href="https://svs.gsfc.nasa.gov/30679" target="_blank" rel="noopener noreferrer">NASA / ESA / STScI</a>
                    <span>G. Bacon, T. Davis, L. Frattare, Z. Levay, F. Summers (Viz 3D Team)</span></p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/portal.js" asp-append-version="true"></script>
    <script src="~/js/astral-motion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
