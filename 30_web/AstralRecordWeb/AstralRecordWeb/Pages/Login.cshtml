@page
@model LoginModel
@{
    ViewData["Title"] = "ログイン";
}

<section class="ar-login-page" aria-labelledby="login-title">
    <div class="ar-login-page__backdrop" aria-hidden="true"></div>
    <div class="container position-relative">
        <div class="row justify-content-center">
            <div class="col-12 col-md-9 col-lg-6">
                <div class="ar-login-card">
                    <p class="ar-alpha-badge ar-alpha-badge--muted">COMING LATER</p>
                    <h1 id="login-title">プレイヤーログイン</h1>
                    <div class="ar-login-card__notice" id="login-unavailable" role="status">
                        <strong>Webログインは現在未実装です。</strong>
                        <span>ゲーム内でのログインコード発行とは別に、このWebフォームからのログインは現在利用できません。</span>
                    </div>

                    <form method="post" aria-describedby="login-unavailable">
                        <fieldset disabled aria-disabled="true">
                            <div class="mb-3">
                                <label asp-for="LoginCode" class="form-label">ログインコード</label>
                                <input asp-for="LoginCode" class="form-control form-control-lg text-uppercase ar-disabled-input"
                                       autocomplete="off" placeholder="準備中" />
                            </div>
                            <button type="submit" class="btn ar-home-button ar-home-button--primary w-100">ログイン</button>
                        </fieldset>
                    </form>

                    <p class="ar-login-card__foot">
                        サーバーへの参加にWebログインは必要ありません。
                        <a asp-page="/Index" asp-fragment="join">参加情報へ戻る</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
