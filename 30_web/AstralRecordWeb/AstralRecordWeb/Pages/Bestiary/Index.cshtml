@page "/bestiary"
@model AstralRecordWeb.Pages.Bestiary.IndexModel
@using AstralRecordWeb.Models
@{
    ViewData["Title"] = "討伐モブ図鑑";
}
@section Styles {
    <link rel="stylesheet" href="~/css/bestiary.css" asp-append-version="true" />
}

<section class="ar-portal ar-bestiary" aria-labelledby="bestiary-title">
    <div class="container">
        <header class="ar-portal-heading">
            <div>
                <h1 id="bestiary-title">討伐モブ図鑑</h1>
                <p class="ar-portal-sub">自分が討伐したモブの記録を確認できます。</p>
            </div>
            <a asp-page="/MyPage" class="btn ar-btn-outline">マイページ</a>
        </header>

        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
        }
        @if (Model.Record is { } record)
        {
            @if (record.AccountId is not null || record.Accounts.Count > 0)
            {
                <section class="ar-bestiary-record" aria-label="アカウントと討伐記録">
                    @if (record.AccountId is not null)
                    {
                        <dl class="ar-bestiary-summary">
                            <div>
                                <dt>表示中のアカウント</dt>
                                <dd><a asp-page="/Players/Detail" asp-route-userUuid="@Model.ViewerUserUuid" asp-route-accountId="@record.AccountId">@record.AccountName</a></dd>
                            </div>
                            <div><dt>発見したモブ</dt><dd>@record.Mobs.Count.ToString("N0") <small>種</small></dd></div>
                            <div><dt>総討伐数</dt><dd>@record.TotalDefeats.ToString("N0") <small>体</small></dd></div>
                        </dl>
                    }
                    @if (record.Accounts.Any(account => account.AccountId != record.AccountId))
                    {
                        <form method="get" class="ar-bestiary-account">
                            <label for="bestiary-account">別のアカウントの記録</label>
                            <div>
                                <select name="accountId" id="bestiary-account" class="form-select" aria-describedby="bestiary-account-help">
                                    @foreach (var account in record.Accounts)
                                    {
                                        <option value="@account.AccountId" selected="@(account.AccountId == record.AccountId)">スロット @account.SlotIndex: @account.AccountName</option>
                                    }
                                </select>
                                <button type="submit" class="btn ar-btn-outline">表示</button>
                            </div>
                            <p id="bestiary-account-help">ゲーム内で選択中のアカウントは変わりません。</p>
                        </form>
                    }
                </section>
            }
            @if (record.AccountId is null)
            {
                <div class="ar-empty">表示するアカウントがありません。ゲーム内でアカウントを選択するか、一覧から選んでください。</div>
            }
            else if (record.Mobs.Count == 0)
            {
                <div class="ar-empty"><h2>まだ討伐したモブの記録はありません</h2><p>ゲーム内でモブを討伐すると図鑑に追加されます。</p></div>
            }
            else
            {
                <form method="get" class="ar-bestiary-filter" role="search" aria-label="討伐済みモブを検索">
                    <input type="hidden" name="accountId" value="@record.AccountId" />
                    <div>
                        <label for="mob-query">モブ名</label>
                        <input id="mob-query" name="query" value="@Model.Query" maxlength="100" type="search" class="form-control" placeholder="名前で探す" />
                    </div>
                    <div>
                        <label for="mob-category">分類</label>
                        <select id="mob-category" asp-for="Category" class="form-select">
                            <option value="">すべて</option><option value="ENEMY">通常モブ</option><option value="BOSS">ボス</option>
                        </select>
                    </div>
                    <div>
                        <label for="mob-sort">並び順</label>
                        <select id="mob-sort" asp-for="Sort" class="form-select">
                            <option value="recent">最終討伐順</option><option value="count">討伐数順</option><option value="name">名前順</option>
                        </select>
                    </div>
                    <button type="submit" class="btn ar-btn-primary">絞り込む</button>
                </form>

                @if (Model.Mobs.Count == 0)
                {
                    <div class="ar-empty">条件に一致するモブがいません。<a asp-page="Index" asp-route-accountId="@record.AccountId">絞り込みを解除</a></div>
                }
                else
                {
                    <p class="ar-bestiary-result">@Model.MatchingCount.ToString("N0") 件</p>
                    <div class="ar-bestiary-grid">
                        @foreach (var mob in Model.Mobs)
                        {
                            <a class="ar-mob-card" asp-page="Detail" asp-route-mobId="@mob.MobId" asp-route-accountId="@record.AccountId">
                                <div class="ar-mob-card-top">
                                    <span class="ar-mob-category @(mob.Category == "BOSS" ? "is-boss" : "")">@BestiaryDisplay.Category(mob.Category)</span>
                                </div>
                                <div class="ar-mob-thumbnail" data-mob-thumbnail data-entity-type="@mob.EntityType" data-mob-name="@mob.Name">
                                    <span data-mob-visual-fallback>@mob.EntityType</span>
                                </div>
                                <h2>@mob.Name</h2>
                                <div class="ar-mob-card-footer"><span>討伐数 <strong>@mob.DefeatCount.ToString("N0")</strong></span></div>
                            </a>
                        }
                    </div>
                    @if (Model.PageCount > 1)
                    {
                        <nav class="ar-pagination" aria-label="図鑑のページ">
                            @if (Model.PageNumber > 1)
                            {
                                <a asp-page="Index" asp-route-accountId="@record.AccountId" asp-route-query="@Model.Query" asp-route-category="@Model.Category"
                                   asp-route-sort="@Model.Sort" asp-route-pageNumber="@(Model.PageNumber - 1)">前へ</a>
                            }
                            <span>@Model.PageNumber / @Model.PageCount</span>
                            @if (Model.PageNumber < Model.PageCount)
                            {
                                <a asp-page="Index" asp-route-accountId="@record.AccountId" asp-route-query="@Model.Query" asp-route-category="@Model.Category"
                                   asp-route-sort="@Model.Sort" asp-route-pageNumber="@(Model.PageNumber + 1)">次へ</a>
                            }
                        </nav>
                    }
                }
                <p class="ar-bestiary-note">保存済みの記録です。ゲーム内での討伐が反映されるまで時間がかかる場合があります。</p>
            }
        }
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/mob-viewer.mjs" asp-append-version="true"></script>
}
