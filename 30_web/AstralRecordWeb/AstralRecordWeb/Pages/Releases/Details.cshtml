@page "/releases/{slug}"
@model AstralRecordWeb.Pages.Releases.DetailsModel
@{
    ViewData["Title"] = Model.ReleaseNote?.Title ?? "リリースノート";
}

@if (Model.ReleaseNote is not null)
{
    var publishedAtJst = Model.ReleaseNote.PublishedAt.ToOffset(TimeSpan.FromHours(9));
    <section class="ar-reading-page" aria-labelledby="release-detail-title">
        <div class="container">
            <p class="ar-breadcrumb"><a asp-page="/Index">ホーム</a><span aria-hidden="true">/</span><a asp-page="/Releases/Index">お知らせ</a></p>
            <header class="ar-reading-mast ar-reading-mast--release">
                <div>
                    <h1 id="release-detail-title">@Model.ReleaseNote.Title</h1>
                    <p>
                        <span class="ar-release-version">@Model.ReleaseNote.Version</span>
                        <time datetime="@publishedAtJst.ToString("yyyy-MM-ddTHH:mm:sszzz")">
                            @publishedAtJst.ToString("yyyy年M月d日 HH:mm")
                        </time>
                    </p>
                </div>
            </header>
            <article class="ar-release-document">
                <div class="ar-markdown-content">
                    @Html.Raw(Model.ReleaseNote.Html)
                </div>
                <a class="ar-reading-link" asp-page="/Releases/Index">お知らせ一覧に戻る</a>
            </article>
        </div>
    </section>
}
