@page
@model AstralRecordWeb.Pages.Releases.IndexModel
@{
    ViewData["Title"] = "お知らせ";
}

<section class="ar-reading-page" aria-labelledby="release-title">
    <div class="container">
        <p class="ar-breadcrumb"><a asp-page="/Index">ホーム</a><span aria-hidden="true">/</span> お知らせ</p>
        <header class="ar-reading-mast">
            <div>
                <h1 id="release-title">お知らせ</h1>
                <p>アップデートやサイトの変更を確認できます。</p>
            </div>
        </header>
        @if (Model.Releases.Count == 0)
        {
            <p class="ar-release-empty">公開済みのお知らせはありません。</p>
        }
        else
        {
            <ul class="ar-release-list">
                @foreach (var release in Model.Releases)
                {
                    var publishedAtJst = release.PublishedAt.ToOffset(TimeSpan.FromHours(9));
                    <li class="ar-release-row">
                        <div class="ar-release-row__meta">
                            <time datetime="@publishedAtJst.ToString("yyyy-MM-ddTHH:mm:sszzz")">@publishedAtJst.ToString("yyyy年M月d日")</time>
                            <span class="ar-release-version">@release.Version</span>
                        </div>
                        <div>
                            <h2><a asp-page="/Releases/Details" asp-route-slug="@release.Slug">@release.Title</a></h2>
                            <p>@release.Summary</p>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>
