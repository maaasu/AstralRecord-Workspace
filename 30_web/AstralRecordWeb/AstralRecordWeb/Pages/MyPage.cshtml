@page
@model MyPageModel
@{ ViewData["Title"] = "マイページ"; ViewData["OwnProfile"] = true; }
<section class="ar-portal">
    <div class="container">
        <header class="ar-portal-heading">
            <div><h1>マイページ</h1><p class="ar-portal-sub">現在のアカウントと冒険の記録を確認できます。</p></div>
            <a asp-page="/MyPage" class="btn ar-btn-outline">情報を更新する</a>
        </header>
        @if (Model.StatusMessage is not null) { <div class="alert alert-success" role="status">@Model.StatusMessage</div> }
        @if (Model.ErrorMessage is not null) { <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div> }
        <nav class="ar-account-links" aria-label="プレイヤー機能">
            <div>
                <h2>ゲーム</h2>
                <ul>
                    @if (Model.Profile is not null)
                    {
                        <li><a asp-page="/Bestiary/Index">自分の討伐モブ図鑑</a></li>
                    }
                    <li><a asp-page="/Market/Index">マーケット</a></li>
                    <li><a asp-page="/Players/Index">プレイヤー一覧</a></li>
                </ul>
            </div>
            <div>
                <h2>受け取り・購入</h2>
                <ul>
                    <li><a asp-page="/Mail/Index">メールと報酬</a></li>
                    <li><a asp-page="/AstraldShop/Index">有償アストラルドショップ</a></li>
                </ul>
            </div>
            <div>
                <h2>アカウント</h2>
                <ul>
                    <li><a asp-page="/LoginSettings">ログイン設定</a></li>
                    <li><a asp-page="/Donations/Index">寄付とDiscord連携</a></li>
                </ul>
            </div>
        </nav>
        @if (Model.Profile is { } profile)
        {
            @if (profile.CurrentAccount is { } selectedAccount)
            {
                <section class="ar-panel"><h2>現在のアカウント特典</h2><p>@selectedAccount.AccountName（スロット @selectedAccount.SlotIndex）</p>
                    @if (Model.Benefits is { } benefits)
                    {
                        <dl class="ar-profile-facts">
                            <div><dt>インスタンス優先接続</dt><dd>残り @benefits.InstancePriorityUses 回</dd></div>
                            <div><dt>VIP</dt><dd>@(benefits.VipTier is "DONER" or "ASTRALDER" ? benefits.VipTier : "なし")</dd></div>
                            <div><dt>有効期限（日本時間）</dt><dd>@(benefits.VipExpiresAt is { } expires ? expires.ToOffset(TimeSpan.FromHours(9)).ToString("yyyy/MM/dd HH:mm") : "—")</dd></div>
                            <div><dt>残り日数</dt><dd>@benefits.RemainingDays 日</dd></div>
                        </dl>
                    }
                    else { <p class="alert alert-warning" role="alert">@Model.BenefitsError</p> }
                </section>
            }
            <partial name="_PlayerProfile" model="profile" />
            <section class="ar-panel ar-visibility" aria-labelledby="visibility-title">
                <div>
                    <h2 id="visibility-title">プロフィールの公開設定</h2>
                    <span class="ar-profile-badge @(profile.IsPublic ? "" : "ar-profile-badge--private")">@(profile.IsPublic ? "公開中" : "非公開")</span>
                    <p>公開すると、MCID・UUID、各アカウントの所持金、レベル、クラス、スキルツリー、総討伐数がプレイヤー一覧と詳細ページに表示されます。モブ別の討伐記録は公開されません。<br />いつでも非公開に戻せます。非公開のプロフィール情報も管理者は確認できます。</p>
                </div>
                <form method="post" asp-page-handler="Visibility">
                    <input type="hidden" name="IsPublic" value="@((!profile.IsPublic).ToString().ToLowerInvariant())" />
                    <button type="submit" class="btn @(profile.IsPublic ? "ar-btn-outline" : "ar-btn-primary")">@(profile.IsPublic ? "非公開にする" : "プロフィールを公開する")</button>
                </form>
            </section>
        }
    </div>
</section>
@section Scripts { <script type="module" src="~/js/skilltree-viewer.js" asp-append-version="true"></script> }
