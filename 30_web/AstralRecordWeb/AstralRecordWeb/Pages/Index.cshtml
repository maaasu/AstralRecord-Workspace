@page
@model IndexModel
@{
    ViewData["Title"] = "Minecraft RPGサーバー";
    var site = Model.PublicSite;
    var javaEndpoint = site.JavaServerPort == 25565
        ? site.JavaServerAddress
        : $"{site.JavaServerAddress}:{site.JavaServerPort}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="ar-home" data-public-phase="@(site.IsOpenAlpha ? "open-alpha" : "release")">
    <section class="ar-home-hero" aria-labelledby="hero-title" data-astral-scene>
        <picture class="ar-journal-landscape" aria-hidden="true">
            <img src="~/images/bg-night-1672.webp"
                 srcset="/images/bg-night-640.webp 640w, /images/bg-night-1280.webp 1280w, /images/bg-night-1672.webp 1672w"
                 sizes="100vw" width="1672" height="941" alt="" fetchpriority="high" />
        </picture>
        <partial name="_AstralAtmosphere" model='"nebula"' />
        <div class="ar-journal-hero-shade" aria-hidden="true"></div>
        <partial name="_MotionControl" />
        <div class="container ar-home-hero__content">
            <p class="ar-home-kicker">Minecraft RPG サーバー</p>
            <h1 class="ar-home-title" id="hero-title">仲間と挑む、<br />剣と魔法の世界。</h1>
            <p class="ar-home-intro">クラスを育て、装備をそろえる。<br />自分の戦い方で、ダンジョンやボスに挑もう。</p>
            <a href="#join" class="ar-plate ar-home-cta">参加方法を見る</a>
        </div>
    </section>

    <section class="ar-home-connect" aria-label="サーバー状況と接続先" data-server-status
             data-status-url="@Url.Page("/Index", "ServerStatus")" data-state="@Model.ServerStatus.State">
        <div class="container ar-home-connect__inner">
            <div class="ar-home-connect__address">
                <div>
                    <span class="ar-home-caption">サーバーアドレス</span>
                    <code class="ar-home-address">@site.JavaServerAddress</code>
                </div>
                <button type="button" class="ar-home-copy" data-copy-server data-copy-value="@site.JavaServerAddress"
                        aria-describedby="home-copy-status" hidden><span data-copy-label>コピー</span></button>
                <span class="visually-hidden" id="home-copy-status" role="status" data-copy-status></span>
            </div>
            <div class="ar-home-connect__status">
                <div class="ar-home-connect__presence">
                    <span class="ar-home-connect__beacon" aria-hidden="true"></span>
                    <strong data-server-state>@Model.ServerStatus.Label</strong>
                </div>
                <span class="ar-home-connect__population">
                    <span class="visually-hidden">参加人数：</span><span data-server-players>@(Model.ServerStatus.Players?.ToString("N0") ?? "—")</span> / <span data-server-maximum>@(Model.ServerStatus.MaximumPlayers?.ToString("N0") ?? "—")</span> 人
                </span>
                <span class="ar-home-connect__checked">最終確認 <time data-server-checked>@Model.ServerStatus.CheckedAt.ToOffset(TimeSpan.FromHours(9)).ToString("HH:mm:ss")</time>（日本時間）</span>
            </div>
            <a class="ar-home-link ar-home-connect__link" href="#join">Java版・統合版の接続情報</a>
        </div>
    </section>

    <div class="container ar-home-paper">
        <section class="ar-home-features" id="features" aria-labelledby="features-title">
            <article class="ar-home-story">
                <img class="ar-home-story__photo" src="~/images/bg-town-640.webp"
                     srcset="/images/bg-town-640.webp 640w, /images/bg-town-1280.webp 1280w"
                     sizes="(max-width: 767px) 100vw, 55vw" width="1280" height="720"
                     alt="ランタンが灯る、木と石で築かれた Minecraft の街" loading="lazy" decoding="async" />
                <div class="ar-home-story__copy">
                    <p class="ar-home-caption">ゲーム紹介</p>
                    <h2 id="features-title">街を出たら、<br />次はどこへ行こう。</h2>
                    <p>クエストを進める。素材を集める。パーティーを組んで強敵に挑む。自分のペースで冒険できます。</p>
                </div>
            </article>
            <article class="ar-home-story ar-home-story--combat">
                <img class="ar-home-story__photo" src="~/images/feature-combat-800.webp"
                     srcset="/images/feature-combat-800.webp 800w, /images/feature-combat-1600.webp 1600w"
                     sizes="(max-width: 767px) 100vw, 55vw" width="1600" height="994"
                     alt="緑に覆われた石造りの街に並ぶ、装備とスキルの案内" loading="lazy" decoding="async" />
                <div class="ar-home-story__copy">
                    <h3>自分の戦い方を見つける。</h3>
                    <p>近接・遠距離・魔法。クラスやスキル、装備を組み合わせ、仲間とダンジョンやボスに挑めます。</p>
                </div>
            </article>
        </section>

        <section class="ar-home-news" aria-labelledby="home-news-title">
            <h2 id="home-news-title">お知らせ</h2>
            @if (Model.LatestRelease is { } release)
            {
                var publishedAt = release.PublishedAt.ToOffset(TimeSpan.FromHours(9));
                <a class="ar-home-news__latest" asp-page="/Releases/Details" asp-route-slug="@release.Slug">
                    <time datetime="@publishedAt.ToString("yyyy-MM-ddTHH:mm:sszzz")">@publishedAt.ToString("yyyy.MM.dd")</time>
                    <span>@release.Title</span>
                </a>
            }
            else
            {
                <p class="ar-home-news__latest">公開済みのお知らせはありません。</p>
            }
            <a class="ar-home-link" asp-page="/Releases/Index">お知らせ一覧</a>
        </section>

        <section class="ar-home-community" id="discord" aria-labelledby="discord-title">
            <div>
                <h2 id="discord-title">冒険の続きは、公式Discordで。</h2>
                <p>攻略の相談や仲間探しに。不具合や改善案もお聞かせください。</p>
            </div>
            <a href="https://discord.gg/Fja6zmpjGX" class="ar-home-link" target="_blank" rel="noopener noreferrer"
               aria-label="公式Discordに参加する（新しいタブで開く）">公式Discordに参加する</a>
        </section>
    </div>

    <section class="ar-home-join" id="join" aria-labelledby="join-title">
        <div class="container">
            <div class="ar-home-join__heading">
                <h2 id="join-title">サーバーへの参加方法</h2>
                <p>お使いの Minecraft を選んでください。サーバーへの参加に Web ログインは不要です。</p>
            </div>

            <div class="ar-home-join__layout">
                <fieldset class="ar-home-edition">
                    <legend>Minecraft の種類</legend>
                    <div class="ar-home-edition__options">
                        <label><input type="radio" name="minecraft-edition" value="java" checked /> Java版 <small>推奨</small></label>
                        <label><input type="radio" name="minecraft-edition" value="bedrock" /> 統合版</label>
                    </div>

                    <div class="ar-home-connection">
                        <div class="ar-home-connection__address">
                            <div>
                                <span class="ar-home-caption">サーバーアドレス</span>
                                <code class="ar-home-address">@site.JavaServerAddress</code>
                            </div>
                            <button type="button" class="ar-home-copy" data-copy-server data-copy-value="@site.JavaServerAddress"
                                    aria-describedby="join-copy-status" hidden><span data-copy-label>コピー</span></button>
                            <span class="visually-hidden" id="join-copy-status" role="status" data-copy-status></span>
                        </div>

                        <dl class="ar-home-connection__meta ar-home-edition__java">
                            <div><dt>Java版ポート</dt><dd>@site.JavaServerPort</dd></div>
                            <div><dt>推奨バージョン</dt><dd>1.21.11</dd></div>
                        </dl>
                        <dl class="ar-home-connection__meta ar-home-edition__bedrock">
                            <div><dt>統合版ポート</dt><dd>@site.BedrockServerPort</dd></div>
                        </dl>
                    </div>

                    <div class="ar-home-steps ar-home-edition__java">
                        <h3>Java版で接続する</h3>
                        <p>Java版は 1.21.11 以上に対応しています。</p>
                        <ol>
                            <li>「マルチプレイ」を開き、「サーバーを追加」を選びます。</li>
                            @if (site.JavaServerPort != 25565)
                            {
                                <li>サーバーアドレス欄に、ポートを含めた <code class="ar-home-address">@javaEndpoint</code> を入力します。</li>
                            }
                            else
                            {
                                <li>上のサーバーアドレスを入力します。</li>
                            }
                            <li>注意事項と利用規約を確認し、追加したサーバーへ接続します。</li>
                        </ol>
                    </div>

                    <div class="ar-home-steps ar-home-edition__bedrock">
                        <h3>統合版で接続する</h3>
                        <p>Java版を前提に開発しているため、統合版では一部の機能や操作に支障が出る場合があります。</p>
                        <ol>
                            <li>「遊ぶ」から「サーバー」を開き、「サーバーを追加」を選びます。</li>
                            <li>上のサーバーアドレスと統合版ポートを入力します。</li>
                            <li>注意事項と利用規約を確認し、追加したサーバーへ接続します。</li>
                        </ol>
                        <a class="ar-home-link" href="#discord">公式Discordで改善案を伝える</a>
                    </div>
                </fieldset>

                <aside class="ar-home-notices" aria-labelledby="join-notices-title">
                    <h3 id="join-notices-title">参加前にご確認ください</h3>
                    @if (site.IsOpenAlpha)
                    {
                        <div class="ar-home-alpha-notice">
                            <p>現在はオープンアルファ期間です。予告なく再起動や停止が発生することがあります。この期間のプレイヤーデータは正式リリース時に引き継がれません。</p>
                            <details>
                                <summary>データと仕様に関する注意事項</summary>
                                <p>プレイヤーデータの不具合、消失、巻き戻りは個別の復旧や補償の対象外です。機能、仕様、バランス、遊べる範囲は予告なく変更されることがあります。</p>
                            </details>
                        </div>
                    }
                    <div class="ar-home-notices__links">
                        <a class="ar-home-link" asp-page="/Terms">利用規約</a>
                        <a class="ar-home-link" asp-page="/Privacy">プライバシーポリシー</a>
                    </div>
                </aside>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/server-status.js" asp-append-version="true"></script>
}
