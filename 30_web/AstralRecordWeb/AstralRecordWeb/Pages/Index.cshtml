@page
@model IndexModel
@{
    ViewData["Title"] = "Minecraft RPGサーバー｜マイクラRPGの世界を冒険しよう";
}

<div class="ar-home" data-public-phase="@(Model.PublicSite.IsOpenAlpha ? "open-alpha" : "release")">
    <section class="ar-home-hero" aria-labelledby="hero-title">
        <picture class="ar-journal-landscape" aria-hidden="true">
            <source media="(max-width: 600px)" srcset="/images/bg-sky-640.webp 640w, /images/bg-sky-1280.webp 1280w" sizes="100vw" />
            <img src="~/images/bg-sky-1920.webp" srcset="/images/bg-sky-1280.webp 1280w, /images/bg-sky-1920.webp 1920w, /images/bg-sky-2560.webp 2560w"
                 sizes="100vw" width="2560" height="1440" alt="" fetchpriority="high" />
        </picture>
        <div class="ar-journal-hero-shade" aria-hidden="true"></div>
        <div class="container ar-home-hero__content">
            <p class="ar-home-kicker"><span class="ar-journal-star" aria-hidden="true">✦</span> A WORLD WORTH EXPLORING</p>
            <h1 class="ar-home-title" id="hero-title">
                <span>剣と魔法で、</span>
                <span>まだ見ぬ世界へ。</span>
            </h1>
            <p class="ar-home-intro">
                いつものMinecraftから、あなただけの冒険へ。<br />
                クラス、装備、スキルを組み合わせ、<br class="ar-desktop-break" />
                仲間とともに、まだ知らない景色に出会おう。
            </p>
            <div class="ar-home-actions">
                <a href="#join" class="btn ar-home-button ar-home-button--primary">今すぐ参加する <span aria-hidden="true">↗</span></a>
                <a href="#features" class="ar-journal-link">遊び方を見る <span aria-hidden="true">↓</span></a>
            </div>
        </div>
        <div class="ar-journal-hero-foot container">
            <span>MINECRAFT JAVA &amp; BEDROCK</span>
            <span>EXPLORE. BUILD YOUR STYLE. BELONG.</span>
        </div>
    </section>

    <section class="ar-server-strip" aria-label="現在のサーバー状況" data-server-status data-status-url="@Url.Page("/Index", "ServerStatus")" data-state="@Model.ServerStatus.State">
        <div class="container ar-server-strip-inner">
            <div class="ar-server-presence"><span class="ar-server-beacon" aria-hidden="true"></span><div><small>現在のサーバー状況</small><strong data-server-state>@Model.ServerStatus.Label</strong></div></div>
            <div class="ar-server-population"><small>参加人数</small><strong><span data-server-players>@(Model.ServerStatus.Players?.ToString("N0") ?? "—")</span><span class="ar-server-capacity"> / <span data-server-maximum>@(Model.ServerStatus.MaximumPlayers?.ToString("N0") ?? "—")</span> 人</span></strong></div>
            <div class="ar-server-checked"><span>@Model.PublicSite.JavaServerAddress</span><small>最終確認 <time data-server-checked>@Model.ServerStatus.CheckedAt.ToOffset(TimeSpan.FromHours(9)).ToString("HH:mm:ss")</time>（日本時間）</small></div>
        </div>
    </section>

    <section class="ar-home-section ar-feature-section" id="features" aria-labelledby="features-title">
        <div class="container">
            <div class="ar-journal-heading">
                <div>
                    <p class="ar-home-kicker">THE ASTRAL EXPERIENCE</p>
                    <h2 id="features-title">この世界で<br />楽しめること。</h2>
                </div>
                <p>Minecraftの操作感はそのままに。<br />装備を整え、スキルを選び、気の向く方へ。<br />冒険の楽しみ方は、ひとつではありません。</p>
            </div>

            <article class="ar-journal-story ar-journal-story--adventure">
                <figure class="ar-journal-photo">
                    <img src="~/images/feature-adventure-800.webp" srcset="/images/feature-adventure-800.webp 800w, /images/feature-adventure-1600.webp 1600w"
                         sizes="(max-width: 767px) 100vw, 60vw" width="1600" height="994" alt="水面に映る、石と木で築かれた大きな門" loading="lazy" decoding="async" />
                    <figcaption>EXPLORATION / 冒険のある風景</figcaption>
                </figure>
                <div class="ar-journal-story-copy">
                    <p class="ar-journal-label">FOLLOW YOUR CURIOSITY</p>
                    <h3>寄り道の先に、<br />次の冒険がある。</h3>
                    <p>Mobとの戦闘、採集、クエスト、ボスやダンジョン。装備を整えて挑む日も、気ままに探索する日も、自分のペースで楽しめます。</p>
                    <ul class="ar-journal-tags" aria-label="冒険の関連システム"><li>クエスト</li><li>採集</li><li>ボス</li><li>ダンジョン</li></ul>
                </div>
            </article>

            <div class="ar-journal-stories">
                <article class="ar-journal-story ar-journal-story--combat">
                    <figure class="ar-journal-photo">
                        <img src="~/images/feature-combat-800.webp" srcset="/images/feature-combat-800.webp 800w, /images/feature-combat-1600.webp 1600w"
                             sizes="(max-width: 767px) 100vw, 50vw" width="1600" height="994" alt="緑に覆われた石造りの街に並ぶ、装備とスキルの案内" loading="lazy" decoding="async" />
                        <figcaption>YOUR PLAYSTYLE / 自分だけの戦い方</figcaption>
                    </figure>
                    <div class="ar-journal-story-copy">
                        <p class="ar-journal-label">MAKE IT YOUR OWN</p>
                        <h3>戦って、組み替える。</h3>
                        <p>近接・遠距離・魔法、属性やシールドを含む独自戦闘。クラス、スキル、装備を組み合わせ、自分に合った戦い方を見つけよう。</p>
                        <ul class="ar-journal-tags" aria-label="戦闘の関連システム"><li>クラス</li><li>スキル</li><li>装備</li><li>ステータス</li></ul>
                    </div>
                </article>
                <article class="ar-journal-story ar-journal-story--community">
                    <figure class="ar-journal-photo">
                        <img src="~/images/feature-community-800.webp" srcset="/images/feature-community-800.webp 800w, /images/feature-community-1600.webp 1600w"
                             sizes="(max-width: 767px) 100vw, 50vw" width="1600" height="994" alt="人々の冒険が交わる、木造の建物と緑が広がる街" loading="lazy" decoding="async" />
                        <figcaption>BETTER TOGETHER / この世界でつながる</figcaption>
                    </figure>
                    <div class="ar-journal-story-copy">
                        <p class="ar-journal-label">FIND YOUR PEOPLE</p>
                        <h3>ひとりでも、仲間とも。</h3>
                        <p>パーティーでの共闘やショップ、プレイヤー同士の取引、マーケット。それぞれの遊び方が、この世界の中でつながっていきます。</p>
                        <ul class="ar-journal-tags" aria-label="交流の関連システム"><li>パーティー</li><li>ショップ</li><li>取引</li><li>マーケット</li></ul>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="ar-journal-world" aria-labelledby="world-title">
        <img class="ar-journal-world-photo" src="~/images/bg-town-1920.webp" srcset="/images/bg-town-640.webp 640w, /images/bg-town-1280.webp 1280w, /images/bg-town-1920.webp 1920w"
             sizes="100vw" width="1920" height="1080" alt="" loading="lazy" decoding="async" />
        <div class="container">
            <div class="ar-journal-world-copy">
                <p class="ar-home-kicker">A GROWING WORLD</p>
                <h2 id="world-title">訪れるたびに、<br />新しい発見を。</h2>
                <p>新しいクエストやダンジョン、装備などを継続して追加していきます。長く遊べる世界を目指して、冒険の続きを育てています。</p>
                <a asp-page="/Releases/Index" class="ar-journal-link">お知らせ・更新情報 <span aria-hidden="true">↗</span></a>
            </div>
        </div>
    </section>

    <section class="ar-discord-section" id="discord" aria-labelledby="discord-title">
        <div class="container">
            <div class="ar-discord-panel">
                <div class="ar-journal-community-sign" aria-hidden="true">Let's<br /> meet.</div>
                <div class="ar-discord-panel__copy">
                    <p class="ar-discord-panel__eyebrow">OFFICIAL DISCORD COMMUNITY</p>
                    <h2 id="discord-title">冒険の続きは、公式Discordで。</h2>
                    <p>最新のお知らせや更新情報、攻略の相談、プレイヤー同士の交流に。<br />不具合や小さな改善案も、公式Discordでお聞かせください。</p>
                    <a href="https://discord.gg/Fja6zmpjGX" class="btn ar-discord-panel__button" target="_blank"
                       rel="noopener noreferrer" aria-label="Astral Record公式Discordに参加する（新しいタブで開く）">
                        公式Discordに参加する <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="ar-home-section ar-join-section" id="join" aria-labelledby="join-title">
        <div class="container">
            <div class="ar-home-heading ar-home-heading--center">
                <p class="ar-home-kicker">Join Astral Record</p>
                <h2 id="join-title">さあ、冒険をはじめよう。</h2>
                <p>Java版はバージョン1.21.11以上に対応しており、1.21.11を推奨しています。Java版でのプレイを前提に作られたサーバーですが、統合版からも参加できます。統合版ではプレイに支障が出る場合があるため、あらかじめご了承ください。</p>
            </div>

            @if (Model.PublicSite.IsOpenAlpha)
            {
                <aside class="ar-alpha-notice" aria-labelledby="alpha-notice-title">
                    <div class="ar-alpha-notice__mark" aria-hidden="true">!</div>
                    <div>
                        <p class="ar-alpha-notice__eyebrow">OPEN ALPHA</p>
                        <h3 id="alpha-notice-title">参加前にご確認ください</h3>
                        <p class="ar-alpha-notice__lead">
                            現在は、開発中のサーバーを公開して遊べるようにしているオープンアルファ期間です。
                        </p>
                        <ul>
                            <li>予告の有無にかかわらず、急な再起動や停止が頻繁に発生することがあります。</li>
                            <li>プレイヤーデータの不具合、消失、巻き戻りは個別の復旧や補償の対象外です。</li>
                            <li>この期間のプレイヤーデータは、正式リリース時に引き継がれません。</li>
                            <li>機能、仕様、バランス、遊べる範囲は予告なく変更されることがあります。</li>
                        </ul>
                    </div>
                </aside>
            }

            <div class="row g-4 justify-content-center">
                <div class="col-lg-7">
                    <article class="ar-edition-card ar-edition-card--available">
                        <div class="ar-edition-card__head">
                            <div>
                                <span class="ar-edition-card__eyebrow">AVAILABLE NOW</span>
                                <h3>Minecraft Java Edition (ver 1.21.11)</h3>
                            </div>
                            <span class="ar-edition-state ar-edition-state--open">公開中</span>
                        </div>

                        <button class="ar-address-button" type="button"
                                data-copy-server data-copy-value="@Model.PublicSite.JavaServerAddress"
                                aria-describedby="join-copy-help join-copy-status">
                            <span>
                                <small>サーバーアドレス</small>
                                <strong>@Model.PublicSite.JavaServerAddress</strong>
                            </span>
                            <span class="ar-address-button__copy" data-copy-label>クリックしてコピー</span>
                        </button>
                        <p class="ar-address-help" id="join-copy-help">ポート: @Model.PublicSite.JavaServerPort（標準ポート）</p>
                        <p class="ar-copy-status" id="join-copy-status" role="status" aria-live="polite" data-copy-status></p>

                        <ol class="ar-join-steps">
                            <li><span>1</span>Java版の「マルチプレイ」を開く</li>
                            <li><span>2</span>「サーバーを追加」に上のアドレスを入力</li>
                            <li><span>3</span>利用規約と注意事項を確認して参加</li>
                        </ol>
                    </article>
                </div>

                <div class="col-lg-5">
                    <article class="ar-edition-card ar-edition-card--available">
                        <div class="ar-edition-card__head">
                            <div>
                                <span class="ar-edition-card__eyebrow">AVAILABLE NOW</span>
                                <h3>Minecraft Bedrock Edition</h3>
                            </div>
                            <span class="ar-edition-state ar-edition-state--open">対応中</span>
                        </div>
                        <p>
                            統合版にも対応しています。IPアドレスはJava版と同じ <strong>@Model.PublicSite.JavaServerAddress</strong>、ポートは <strong>@Model.PublicSite.BedrockServerPort</strong>（標準ポート）です。
                        </p>
                        <p>当サーバーはJava版でのプレイを前提としているため、統合版では一部の機能やプレイに支障があるかもしれません。細かいことでも、公式Discordの改善案チャンネルでお知らせいただければ修正される可能性があります。</p>
                    </article>
                </div>
            </div>

            <div class="ar-join-footer">
                <p>参加前に、利用規約とプライバシーポリシーをご確認ください。</p>
                <div>
                    <a asp-page="/Terms" class="ar-text-link">利用規約</a>
                    <a asp-page="/Privacy" class="ar-text-link">プライバシーポリシー</a>
                    <a asp-page="/Login" class="ar-text-link">ログイン</a>
                </div>
            </div>
        </div>
    </section>

</div>

@section Scripts { <script src="~/js/server-status.js" asp-append-version="true"></script> }
