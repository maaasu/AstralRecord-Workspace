@page
@model IndexModel
@{
    ViewData["Title"] = "ホーム";
}

<div class="ar-home" data-public-phase="@(Model.PublicSite.IsOpenAlpha ? "open-alpha" : "release")">
    <section class="ar-home-hero" aria-labelledby="hero-title">
        <div class="ar-home-hero__sky" data-depth-layer="sky" aria-hidden="true"></div>
        <div class="ar-home-hero__town" data-depth-layer="town" aria-hidden="true"></div>
        <div class="ar-home-hero__glow" aria-hidden="true"></div>
        <div class="ar-home-stars" aria-hidden="true"></div>

        <div class="container ar-home-hero__content">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <p class="ar-home-kicker">Minecraft Java Edition RPG Server</p>
                    <h1 class="ar-home-title" id="hero-title">
                        <span>剣と魔法で、</span>
                        <span>まだ見ぬ世界へ。</span>
                    </h1>
                    <p class="ar-home-intro">
                        Astral Recordは、クラスや装備、スキルを組み合わせて遊ぶMinecraft RPGサーバーです。
                        自分に合った戦い方を組み立て、仲間と一緒にダンジョンやボスへ挑めます。
                    </p>
                    <div class="ar-home-actions">
                        <a href="#join" class="btn ar-home-button ar-home-button--primary">今すぐ参加する</a>
                        <a href="#features" class="btn ar-home-button ar-home-button--ghost">遊び方を見る</a>
                    </div>
                </div>

                <div class="col-lg-5 d-none d-lg-block" aria-hidden="true">
                    <div class="ar-astral-mark" data-depth-layer="mark">
                        <div class="ar-astral-mark__orbit ar-astral-mark__orbit--outer"></div>
                        <div class="ar-astral-mark__orbit ar-astral-mark__orbit--inner"></div>
                        <div class="ar-astral-mark__core">
                            <img src="~/images/icon.png"
                                 srcset="/images/icon-128.webp 128w, /images/icon-256.webp 256w, /images/icon-512.webp 512w"
                                 sizes="194px" width="512" height="512" alt="" />
                        </div>
                        <span class="ar-astral-mark__rune ar-astral-mark__rune--one">STATUS</span>
                        <span class="ar-astral-mark__rune ar-astral-mark__rune--two">SKILL</span>
                        <span class="ar-astral-mark__rune ar-astral-mark__rune--three">DUNGEON</span>
                    </div>
                </div>
            </div>
        </div>

        <a class="ar-scroll-cue" href="#features" aria-label="特徴までスクロール">
            <span aria-hidden="true"></span>
        </a>
    </section>

    <section class="ar-home-section ar-feature-section" id="features" aria-labelledby="features-title">
        <div class="container">
            <div class="ar-home-heading">
                <p class="ar-home-kicker">What you can find</p>
                <h2 id="features-title">この世界で楽しめること</h2>
                <p>
                    Minecraftの操作感はそのままに、装備を整え、スキルを選び、手応えのある戦闘や探索を楽しめます。
                </p>
            </div>

            <div class="ar-feature-grid">
                <article class="ar-feature-card ar-feature-card--combat">
                    <div class="ar-feature-card__number" aria-hidden="true">01</div>
                    <div class="ar-feature-card__icon" aria-hidden="true">✦</div>
                    <h3>戦って、組み替える</h3>
                    <p>
                        近接・遠距離・魔法、属性やシールドを含む独自戦闘を軸に、クラス、スキル、装備で戦い方を組み立てます。
                    </p>
                    <ul aria-label="関連システム">
                        <li>クラス</li>
                        <li>スキル</li>
                        <li>装備</li>
                        <li>ステータス</li>
                    </ul>
                </article>

                <article class="ar-feature-card ar-feature-card--adventure">
                    <div class="ar-feature-card__number" aria-hidden="true">02</div>
                    <div class="ar-feature-card__icon" aria-hidden="true">⌖</div>
                    <h3>寄り道も、攻略も</h3>
                    <p>
                        Mobとの戦闘、採集、クエスト、ボスやダンジョン。更新を重ねながら、冒険できる場所や遊び方を増やしていきます。
                    </p>
                    <ul aria-label="関連システム">
                        <li>クエスト</li>
                        <li>採集</li>
                        <li>ボス</li>
                        <li>ダンジョン</li>
                    </ul>
                </article>

                <article class="ar-feature-card ar-feature-card--community">
                    <div class="ar-feature-card__number" aria-hidden="true">03</div>
                    <div class="ar-feature-card__icon" aria-hidden="true">◇</div>
                    <h3>ひとりでも、仲間とも</h3>
                    <p>
                        パーティーでの共闘やショップ、プレイヤー同士の取引、マーケットを通して、それぞれの遊び方で世界に関われます。
                    </p>
                    <ul aria-label="関連システム">
                        <li>パーティー</li>
                        <li>ショップ</li>
                        <li>取引</li>
                        <li>マーケット</li>
                    </ul>
                </article>
            </div>
        </div>
    </section>

    <section class="ar-world-section" aria-labelledby="world-title">
        <div class="ar-world-section__image" data-depth-layer="world" aria-hidden="true"></div>
        <div class="ar-world-section__shade" aria-hidden="true"></div>
        <div class="container position-relative">
            <div class="ar-world-copy">
                <p class="ar-home-kicker">A growing world</p>
                <h2 id="world-title">遊び方は、これからも増えていく。</h2>
                <p>
                    新しいクエストやダンジョン、装備などを継続して追加していきます。
                    訪れるたびに新しい発見がある、長く遊べる世界を目指して育てていきます。
                </p>
            </div>
        </div>
    </section>

    <section class="ar-discord-section" id="discord" aria-labelledby="discord-title">
        <div class="container">
            <div class="ar-discord-panel">
                <div class="ar-discord-panel__mark" aria-hidden="true">
                    <span></span><span></span><span></span>
                </div>
                <div class="ar-discord-panel__copy">
                    <p class="ar-discord-panel__eyebrow">OFFICIAL DISCORD COMMUNITY</p>
                    <h2 id="discord-title">冒険の続きは、公式Discordで。</h2>
                    <p>
                        最新のお知らせや更新情報を受け取り、攻略の相談やプレイヤー同士の交流、不具合の報告にご利用いただけます。
                        細かいことでも公式Discordの改善案チャンネルへお知らせください。内容によっては修正されるかもしれません。
                    </p>
                    <ul aria-label="公式Discordでできること">
                        <li>更新情報</li>
                        <li>攻略・交流</li>
                        <li>不具合報告</li>
                    </ul>
                </div>
                <a href="https://discord.gg/Fja6zmpjGX" class="btn ar-discord-panel__button" target="_blank"
                   rel="noopener noreferrer" aria-label="Astral Record公式Discordに参加する（新しいタブで開く）">
                    公式Discordに参加する <span aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
    </section>

    <section class="ar-home-section ar-join-section" id="join" aria-labelledby="join-title">
        <div class="container">
            <div class="ar-home-heading ar-home-heading--center">
                <p class="ar-home-kicker">Join Astral Record</p>
                <h2 id="join-title">参加情報</h2>
                <p>Java版でのプレイを前提に作られたサーバーですが、統合版からも参加できます。統合版ではプレイに支障が出る場合があるため、あらかじめご了承ください。</p>
            </div>

            @if (Model.PublicSite.IsOpenAlpha)
            {
                <aside class="ar-alpha-notice" aria-labelledby="alpha-notice-title">
                    <div class="ar-alpha-notice__mark" aria-hidden="true">!</div>
                    <div>
                        <p class="ar-alpha-notice__eyebrow">OPEN ALPHA</p>
                        <h3 id="alpha-notice-title">参加前にご確認ください</h3>
                        <p class="ar-alpha-notice__lead">
                            現在は、開発中のサーバーを公開して遊べるようにしているオープンアルファ期間です。
                        </p>
                        <ul>
                            <li>予告の有無にかかわらず、急な再起動や停止が頻繁に発生することがあります。</li>
                            <li>プレイヤーデータの不具合、消失、巻き戻りは個別の復旧や補償の対象外です。</li>
                            <li>この期間のプレイヤーデータは、正式リリース時に引き継がれません。</li>
                            <li>機能、仕様、バランス、遊べる範囲は予告なく変更されることがあります。</li>
                        </ul>
                    </div>
                </aside>
            }

            <div class="row g-4 justify-content-center">
                <div class="col-lg-7">
                    <article class="ar-edition-card ar-edition-card--available">
                        <div class="ar-edition-card__head">
                            <div>
                                <span class="ar-edition-card__eyebrow">AVAILABLE NOW</span>
                                <h3>Minecraft Java Edition</h3>
                            </div>
                            <span class="ar-edition-state ar-edition-state--open">公開中</span>
                        </div>

                        <button class="ar-address-button" type="button"
                                data-copy-server data-copy-value="@Model.PublicSite.JavaServerAddress"
                                aria-describedby="join-copy-help join-copy-status">
                            <span>
                                <small>サーバーアドレス</small>
                                <strong>@Model.PublicSite.JavaServerAddress</strong>
                            </span>
                            <span class="ar-address-button__copy" data-copy-label>クリックしてコピー</span>
                        </button>
                        <p class="ar-address-help" id="join-copy-help">ポート: @Model.PublicSite.JavaServerPort（標準ポート）</p>
                        <p class="ar-copy-status" id="join-copy-status" role="status" aria-live="polite" data-copy-status></p>

                        <ol class="ar-join-steps">
                            <li><span>1</span>Java版の「マルチプレイ」を開く</li>
                            <li><span>2</span>「サーバーを追加」に上のアドレスを入力</li>
                            <li><span>3</span>利用規約と注意事項を確認して参加</li>
                        </ol>
                    </article>
                </div>

                <div class="col-lg-5">
                    <article class="ar-edition-card ar-edition-card--available">
                        <div class="ar-edition-card__head">
                            <div>
                                <span class="ar-edition-card__eyebrow">AVAILABLE NOW</span>
                                <h3>Minecraft Bedrock Edition</h3>
                            </div>
                            <span class="ar-edition-state ar-edition-state--open">対応中</span>
                        </div>
                        <p>
                            統合版にも対応しています。IPアドレスはJava版と同じ <strong>@Model.PublicSite.JavaServerAddress</strong>、ポートは <strong>@Model.PublicSite.BedrockServerPort</strong>（標準ポート）です。
                        </p>
                        <p>当サーバーはJava版でのプレイを前提としているため、統合版では一部の機能やプレイに支障があるかもしれません。細かいことでも、公式Discordの改善案チャンネルでお知らせいただければ修正される可能性があります。</p>
                    </article>
                </div>
            </div>

            <div class="ar-join-footer">
                <p>参加前に、利用規約とプライバシーポリシーをご確認ください。</p>
                <div>
                    <a asp-page="/Terms" class="ar-text-link">利用規約</a>
                    <a asp-page="/Privacy" class="ar-text-link">プライバシーポリシー</a>
                    <a asp-page="/Login" class="ar-text-link">ログイン（現在未実装）</a>
                </div>
            </div>
        </div>
    </section>

</div>
