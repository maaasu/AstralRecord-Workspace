@page
@model ReauthenticateModel
@{ ViewData["Title"] = "本人確認"; }
<section class="ar-portal"><div class="container">
    <div class="ar-panel">
        <h1>Minecraftで本人確認</h1>
        <p>設定の有効化・パスワードの再設定、管理画面の利用には本人確認が必要です。</p>
        <p>現在ログインしている <strong>@User.Identity?.Name</strong> のMinecraftアカウントで <code>/web login</code> を実行してください。確認は5分間有効です。</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <label asp-for="LoginCode" class="form-label">ログインコード</label>
            <input asp-for="LoginCode" class="form-control mb-3" maxlength="32" autocomplete="one-time-code" required placeholder="ABCD-EFGH" />
            <div class="form-check mb-3">
                <input asp-for="TrustBrowser" class="form-check-input" />
                <label asp-for="TrustBrowser" class="form-check-label">このブラウザを信頼する</label>
                <div class="form-text">選択すると、このブラウザでは管理者モードを最終利用から7日間維持します。共有端末では選択しないでください。</div>
            </div>
            <button type="submit" class="btn ar-btn-primary">本人確認する</button>
            <a asp-page="/MyPage" class="btn ar-btn-outline">マイページに戻る</a>
        </form>
    </div>
</div></section>
