@page
@model AstralRecordWeb.Pages.Admin.History.DungeonsModel
@using System.Globalization
@using AstralRecordWeb.Pages.Admin.History
@{ ViewData["Title"] = "ダンジョン攻略履歴"; }
@section Styles { <link rel="stylesheet" href="~/css/history.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/history-search.js" asp-append-version="true"></script> }
<section class="ar-portal"><div class="container">
    <header class="ar-portal-heading"><div><p class="ar-portal-eyebrow">管理者専用・活動履歴</p><h1>ダンジョン攻略履歴</h1><p class="ar-portal-sub">攻略回数・所要時間と、一緒に参加したプレイヤーの移動距離を確認します。</p></div></header>
    <partial name="_HistoryNav" />
    <form method="get" class="ar-panel ar-history-filters" aria-label="ダンジョン攻略の検索">
        <partial name="_HistoryFilters" model="Model" />
        <div class="ar-history-entity-search" data-history-entity-search data-suggestions-url="@Url.Page("/Admin/History/Dungeons", "Suggestions")">
            <label for="DungeonSearch">ダンジョンID・名称</label>
            <input id="DungeonSearch" name="dungeonId" value="@Model.DungeonSearch" maxlength="128" placeholder="ID またはダンジョン名" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="dungeon-search-suggestions" aria-describedby="dungeon-search-status" />
            <ul id="dungeon-search-suggestions" class="ar-history-suggestions" role="listbox" aria-label="ダンジョンの候補" data-history-suggestions hidden></ul>
            <p id="dungeon-search-status" class="ar-history-suggestion-status" role="status" aria-live="polite" data-history-search-status>2文字以上入力すると候補を表示します。名称を直接入力して検索することもできます。</p>
        </div>
        <div><label asp-for="View">表示</label><select asp-for="View"><option value="runs">攻略回ごとの記録</option><option value="players">プレイヤー別の攻略回数</option></select></div>
        <div><label asp-for="Sort">並び順</label><select asp-for="Sort"><option value="recent">攻略日時が新しい順（攻略回）</option><option value="count">攻略回数が多い順（プレイヤー）</option><option value="fastest">攻略時間が短い順（プレイヤーは最速記録）</option><option value="slowest">攻略時間が長い順（プレイヤーは平均時間）</option></select></div>
        <input type="hidden" asp-for="UserUuid" /><input type="hidden" asp-for="AccountId" />
        <button class="btn ar-btn-primary">検索する</button>
    </form>
    <p class="ar-history-note">時刻は日本時間（JST）。移動距離はテレポートを除く概算です。棒は同じ攻略回の最大距離との比較で、操作量や不正を断定するものではありません。「観測なし」は0mと区別します。</p>
    <p class="ar-history-note">ランキングは検索条件内の成功した攻略を対象に、全件を並べ替えてから表示します。同じダンジョンを比較するときはダンジョンIDまたは名称で絞り込んでください。プレイヤーの最速・平均は参加した攻略回全体の時間です。同時間は攻略日時・記録ID等で表示順を固定します。</p>
    @if (Model.AccountId is not null || Model.UserUuid is not null) { <p><a asp-page="Dungeons" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-view="@Model.View" asp-route-sort="@Model.Sort" asp-route-dungeonId="@Model.DungeonSearch">プレイヤーの絞り込みを解除</a></p> }
    @if (Model.ErrorMessage is not null) { <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div> }
    @if (Model.Results is { } results)
    {
        <p>期間内 @results.TotalCount.ToString("N0") 回の攻略</p>
        @if (results.Items.Count == 0) { <div class="ar-empty">条件に一致する記録はありません。</div> }
        @for (var index = 0; index < results.Items.Count; index++)
        {
            var run = results.Items[index];
            var maxDistance = Math.Max(1m, run.Participants.Select(p => p.DistanceMeters ?? 0m).DefaultIfEmpty().Max());
            <article class="ar-history-card">
                <h2>@if (Model.Sort is "fastest" or "slowest") { <span class="ar-profile-badge">@(((long)Model.PageNumber - 1) * results.PageSize + index + 1) 位</span> } @run.DungeonName <span class="ar-profile-badge">所要時間 @HistoryPageModel.Duration(run.DurationSeconds)</span></h2>
                <p class="ar-history-note">開始 @HistoryPageModel.Timestamp(run.StartedAt) → 攻略 @HistoryPageModel.Timestamp(run.ClearedAt) JST<br />@run.DungeonId ／ 記録 @run.EventId</p>
                <div class="ar-history-table-wrap"><table class="ar-history-table"><thead><tr><th>参加プレイヤー</th><th>アカウント</th><th>移動距離</th><th>観測回数</th></tr></thead><tbody>
                @foreach (var participant in run.Participants)
                {
                    <tr><td>@participant.Player.Mcid</td><td><a asp-page="/Players/Detail" asp-route-userUuid="@participant.Player.UserUuid" asp-route-accountId="@participant.Player.AccountId" asp-route-includePrivate="true">@participant.Player.AccountName</a><small>@participant.Player.AccountId</small></td><td>
                        @if (participant.DistanceMeters is { } distance && participant.MovementSampleCount > 0)
                        { <div class="ar-history-distance"><meter min="0" max="@maxDistance.ToString(CultureInfo.InvariantCulture)" value="@distance.ToString(CultureInfo.InvariantCulture)" aria-label="@($"{participant.Player.Mcid} の移動距離 {distance:N1} m")"></meter><strong>@distance.ToString("N1") m</strong></div> }
                        else { <span>観測なし</span> }
                    </td><td>@participant.MovementSampleCount.ToString("N0")</td></tr>
                }
                </tbody></table></div>
            </article>
        }
    }
    @if (Model.Players is { } players)
    {
        <p>@players.TotalCount.ToString("N0") アカウント</p>
        @if (players.Items.Count == 0) { <div class="ar-empty">条件に一致する記録はありません。</div> }
        <div class="ar-history-table-wrap"><table class="ar-history-table"><thead><tr><th>順位</th><th>プレイヤー / アカウント</th><th>攻略回数</th><th>最速時間</th><th>平均時間</th><th>記録済み移動距離の合計</th><th>最後の攻略（JST）</th></tr></thead><tbody>
        @for (var index = 0; index < players.Items.Count; index++)
        {
            var player = players.Items[index];
            <tr><td>@(((long)Model.PageNumber - 1) * players.PageSize + index + 1)</td><td>@player.Player.Mcid / <a asp-page="/Players/Detail" asp-route-userUuid="@player.Player.UserUuid" asp-route-accountId="@player.Player.AccountId" asp-route-includePrivate="true">@player.Player.AccountName</a><small>@player.Player.AccountId</small></td><td>@player.ClearCount.ToString("N0") 回</td><td class="ar-history-value">@HistoryPageModel.Duration(player.BestDurationSeconds)</td><td class="ar-history-value">@HistoryPageModel.Duration(player.AverageDurationSeconds)</td><td>@(player.TotalDistanceMeters is { } meters ? $"{meters:N1} m" : "観測なし")</td><td>@HistoryPageModel.Timestamp(player.LastClearedAt)</td></tr>
        }
        </tbody></table></div>
    }
    @if (Model.Results is not null || Model.Players is not null)
    {
        var count = Model.Results?.TotalCount ?? Model.Players!.TotalCount;
        var size = Model.Results?.PageSize ?? Model.Players!.PageSize;
        <nav class="ar-pagination" aria-label="ダンジョン履歴のページ">
            @if (Model.PageNumber > 1) { <a href="@Model.PageLink(Model.PageNumber - 1)" class="btn ar-btn-outline">前へ</a> }
            <span>@Model.PageNumber / @Math.Max(1, (int)Math.Ceiling(count / (double)size))</span>
            @if ((long)Model.PageNumber * size < count) { <a href="@Model.PageLink(Model.PageNumber + 1)" class="btn ar-btn-outline">次へ</a> }
        </nav>
    }
</div></section>
