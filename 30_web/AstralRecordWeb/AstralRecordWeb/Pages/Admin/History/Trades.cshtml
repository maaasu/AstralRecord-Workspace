@page
@model AstralRecordWeb.Pages.Admin.History.TradesModel
@using AstralRecordWeb.Pages.Admin.History
@{ ViewData["Title"] = "トレード履歴"; }
@section Styles { <link rel="stylesheet" href="~/css/history.css" asp-append-version="true" /> }
<section class="ar-portal"><div class="container">
    <header class="ar-portal-heading"><div><h1>トレード履歴</h1><p class="ar-portal-sub">成立したトレードの送り手・受け手と、送ったアイテムを確認します。</p></div></header>
    <partial name="_HistoryNav" />
    <form method="get" class="ar-panel ar-history-filters" aria-label="トレードの検索">
        <partial name="_HistoryFilters" model="Model" />
        <input type="hidden" asp-for="UserUuid" /><input type="hidden" asp-for="OtherUserUuid" /><input type="hidden" asp-for="AccountId" />
        <button class="btn ar-btn-primary">検索する</button>
    </form>
    @if (Model.UserUuid is not null || Model.AccountId is not null || Model.OtherUserUuid is not null) { <p class="ar-history-note">選択したプレイヤー／アカウントに絞り込み中。<a asp-page="Trades" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">絞り込みを解除</a></p> }
    <p class="ar-history-note">成立日時は日本時間（JST）です。各行を開くと、送ったアイテムとアカウントの詳細を確認できます。導入後に記録できたトレードのみを表示します。</p>
    @if (Model.ErrorMessage is not null) { <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div> }
    @if (Model.Results is { } results)
    {
        <p>期間内 @results.TotalCount.ToString("N0") 回</p>
        @if (results.Items.Count == 0) { <div class="ar-empty">条件に一致する記録はありません。</div> }
        else
        {
            <div class="ar-history-list">
                @foreach (var trade in results.Items)
                {
                    <details class="ar-history-entry">
                        <summary>
                            <span class="ar-history-entry-main">
                                <span><span class="ar-history-entry-label">成立日時（JST）</span><time datetime="@DateTime.SpecifyKind(trade.CompletedAt, DateTimeKind.Utc).ToString("O")">@HistoryPageModel.Timestamp(trade.CompletedAt)</time></span>
                                <span><span class="ar-history-entry-label">送り手</span><strong>@trade.Source.AccountName</strong> <span class="ar-history-entry-meta">(@trade.Source.Mcid)</span></span>
                                <span><span class="ar-history-entry-label">受け手</span><strong>@trade.Destination.AccountName</strong> <span class="ar-history-entry-meta">(@trade.Destination.Mcid)</span></span>
                                <span>
                                    <span class="ar-history-entry-label">送った内容</span>
                                    @if (trade.Items.Count > 0)
                                    {
                                        var firstItem = trade.Items[0];
                                        <span>@Html.Raw(Model.FormatItemName(firstItem)) × @firstItem.Quantity.ToString("N0")</span>
                                        @if (trade.Items.Count > 1) { <span class="ar-history-entry-meta">ほか @((trade.Items.Count - 1).ToString("N0")) 件</span> }
                                    }
                                    @if (trade.Gold > 0) { <span>@trade.Gold.ToString("N0") ゴールド</span> }
                                    @if (trade.Items.Count == 0 && trade.Gold <= 0) { <span>送付内容の記録なし</span> }
                                </span>
                            </span>
                            <span class="ar-history-toggle"><span>詳細を表示</span><span>詳細を閉じる</span></span>
                        </summary>
                        <div class="ar-history-entry-body">
                            <dl class="ar-history-facts">
                                <div>
                                    <dt>送り手</dt>
                                    <dd>@trade.Source.Mcid / <a asp-page="/Players/Detail" asp-route-userUuid="@trade.Source.UserUuid" asp-route-accountId="@trade.Source.AccountId" asp-route-includePrivate="true">@trade.Source.AccountName</a><small>アカウントID @trade.Source.AccountId</small></dd>
                                </div>
                                <div>
                                    <dt>受け手</dt>
                                    <dd>@trade.Destination.Mcid / <a asp-page="/Players/Detail" asp-route-userUuid="@trade.Destination.UserUuid" asp-route-accountId="@trade.Destination.AccountId" asp-route-includePrivate="true">@trade.Destination.AccountName</a><small>アカウントID @trade.Destination.AccountId</small></dd>
                                </div>
                                <div><dt>イベントID</dt><dd>@trade.EventId</dd></div>
                            </dl>
                            @if (trade.Items.Count > 0)
                            {
                                <h2>送ったアイテム（@trade.Items.Count.ToString("N0") 件）</h2>
                                <ol class="ar-history-transfer">
                                    @foreach (var item in trade.Items)
                                    {
                                        <li>@Html.Raw(Model.FormatItemName(item)) × @item.Quantity.ToString("N0")<small>@item.ItemId</small></li>
                                    }
                                </ol>
                            }
                            @if (trade.Gold > 0) { <p>ゴールド @trade.Gold.ToString("N0")</p> }
                        </div>
                    </details>
                }
            </div>
        }
        <nav class="ar-pagination" aria-label="トレード履歴のページ">
            @if (Model.PageNumber > 1) { <a href="@Model.PageLink(Model.PageNumber - 1)" class="btn ar-btn-outline">前へ</a> }
            <span>@Model.PageNumber / @Math.Max(1, (int)Math.Ceiling(results.TotalCount / (double)results.PageSize))</span>
            @if ((long)Model.PageNumber * results.PageSize < results.TotalCount) { <a href="@Model.PageLink(Model.PageNumber + 1)" class="btn ar-btn-outline">次へ</a> }
        </nav>
    }
</div></section>
