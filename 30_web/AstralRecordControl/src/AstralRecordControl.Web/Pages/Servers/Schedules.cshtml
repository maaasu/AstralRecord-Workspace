@page "/Servers/{serverId:guid}/Schedules"
@model AstralRecordControl.Web.Pages.Servers.SchedulesModel
@{ ViewData["Title"] = "定期再起動・予約"; ViewData["ServerTab"] = "Schedules"; ViewData["ServerManaged"] = Model.Kind == ServerKind.Java; ViewData["ServerProcessManaged"] = ServerProcessSupport.IsSupported(Model.Kind); }
<h1>@Model.Server.DisplayName — 定期再起動・予約</h1>
<partial name="_ServerTabs" model="Model.Server.ServerId" />
<p>適用済みの予約は管理Webに接続できなくても、このPC内で実行します。開始が60秒を超えて遅れた予約はスキップします。</p>
<p>同じサーバーの予約は実行時刻を分けてください。再起動・更新など別の処理と重なった予約はスキップされます。</p>
@if (!Model.Available) { <p>予約実行は無効です。導入手順に従って有効化してください。</p> }
@if (Model.Message != null) { <p role="status">@Model.Message</p> }
<div asp-validation-summary="All"></div>
@foreach (var request in Model.PendingRequests)
{
    <form method="post" asp-page-handler="RunNow" asp-route-scheduleId="@request.ScheduleId">
        <p>@(request.RejectionCode == null ? "受付の確認待ち" : "開始前に拒否")：@request.OperationId @request.RejectionCode（@request.CreatedAtUtc.ToString("u")）</p>
        <input type="hidden" name="RequestKey" value="@request.OperationId" />
        <button disabled="@(request.RejectionCode != null)">同じ要求を照合</button>
    </form>
}
@foreach (var row in Model.Schedules)
{
    var definition = row.Definition;
    <section>
        <h2>@AstralRecordControl.Web.Pages.Servers.SchedulesModel.Description(definition)</h2>
        <p>@definition.Trigger.Kind / @(definition.Enabled ? "有効" : "無効") / 希望版 @definition.Revision / 適用版 @(row.AppliedRevision?.ToString() ?? "未適用")</p>
        <p><a class="button-link" asp-page="/Servers/Schedules" asp-route-serverId="@Model.Server.ServerId" asp-route-edit="@definition.ScheduleId">編集</a></p>
        <form method="post" asp-page-handler="RunNow" asp-route-scheduleId="@definition.ScheduleId">
            <input type="hidden" name="RequestKey" value="@Guid.NewGuid()" />
            <button disabled="@(!Model.Available || !definition.Enabled || row.AppliedRevision != definition.Revision)">今すぐ実行</button>
        </form>
        <table><thead><tr><th>予定UTC</th><th>結果</th><th>詳細</th></tr></thead><tbody>
        @foreach (var item in Model.History[definition.ScheduleId])
        {
            <tr><td>@item.ScheduledAtUtc.ToString("u") @(item.Manual ? "(手動)" : "")</td><td>@item.Status</td><td>@item.ErrorCode / @item.OperationId</td></tr>
        }
        </tbody></table>
    </section>
}
<h2>@(Model.ScheduleId.HasValue ? "予約を編集" : "予約を追加")</h2>
<form method="post" asp-page-handler="Save" class="schedule-editor">
    <input asp-for="RequestKey" type="hidden" /><input asp-for="ScheduleId" type="hidden" /><input asp-for="Revision" type="hidden" />
    <label><input asp-for="Enabled" /> 有効</label>
    <label asp-for="Preset">予約する処理</label>
    <select asp-for="Preset">
        <option value="DailyRestart">毎日の定期再起動</option>
        @if (Model.IsVelocity) { <option value="DailyGeyserUpdate">毎日の GeyserMC 自動更新</option> }
        <option value="Advanced">詳細設定（間隔・Cron・複数の処理）</option>
    </select>
    <div class="schedule-daily">
        <label asp-for="DailyTime">毎日の実行時刻</label><input asp-for="DailyTime" type="time" step="60" />
        <p>定期再起動は稼働中のサーバーを正常停止して起動します。停止中のサーバーは起動しません。</p>
        @if (Model.IsVelocity)
        {
            <p>GeyserMC 自動更新は、導入済みの <code>plugins/Geyser-Velocity.jar</code> を公式最新版へ更新します。同じ版なら停止せず、更新時は正常停止し、直前まで稼働していた場合だけ起動します。旧 JAR は退避して残します。</p>
            @if (!Model.GeyserAvailable) { <p>GeyserMC 更新にはファイル操作の有効化と、この機能に対応した Agent / Runner が必要です。</p> }
        }
    </div>
    <div class="schedule-advanced">
    <label asp-for="TriggerKind">実行方式</label><select asp-for="TriggerKind" asp-items="Html.GetEnumSelectList<AstralRecordControl.Contracts.ScheduleTriggerKind>()"></select>
    <label asp-for="AtUtc">日時／間隔の基準時刻（UTC、例 2026-10-19T00:00:00Z）</label><input asp-for="AtUtc" />
    <label asp-for="Seconds">間隔（秒、60以上）</label><input asp-for="Seconds" type="number" min="60" max="31536000" />
    <label asp-for="Expression">Cron（分 時 日 月 曜日）</label><input asp-for="Expression" maxlength="128" />
    <label asp-for="StepsJson">処理の順序（JSON、最大16件）</label><textarea asp-for="StepsJson" rows="8" maxlength="65536"></textarea>
    <p>Start / Stop / Restart / ConsoleCommand / CreateBackup / PruneBackups / UpdateGeyser（Velocityのみ）を指定できます。stepKeyは各処理の識別名、delaySecondsは開始前の待ち秒数です。失敗すると後続処理を中止します。</p>
    <p>告知の例：<code>{"stepKey":"announce","kind":"ConsoleCommand","payload":{"command":"say サーバーを再起動します"},"delaySeconds":0}</code></p>
    </div>
    <label asp-for="TimeZoneId">毎日の時刻・Cronのタイムゾーン</label><input asp-for="TimeZoneId" maxlength="128" />
    <p>日本時間は Asia/Tokyo です。変更はこのサーバーの予約にだけ適用されます。</p>
    <button disabled="@(!Model.Available)">保存</button>
</form>
<p><a class="button-link" asp-page="/Servers/Index">サーバー一覧へ戻る</a></p>
