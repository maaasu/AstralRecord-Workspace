@page "/Servers/{serverId:guid}/Operations"
@model AstralRecordControl.Web.Pages.Servers.OperationsModel
@using AstralRecordControl.Contracts
@using AstralRecordControl.Web.Pages.Shared
@{
    ViewData["Title"] = Model.Server.DisplayName + " · 操作・ログ";
    ViewData["ServerTab"] = "Operations";
    ViewData["ServerManaged"] = Model.Kind == ServerKind.Java;
    ViewData["ServerProcessManaged"] = ServerProcessSupport.IsSupported(Model.Kind);
    var availability = Model.Availability;
    var maintenanceStart = Model.MaintenanceLeases.FirstOrDefault();
    var latestOperation = Model.Recent.FirstOrDefault();
}
<h1>@Model.Server.DisplayName · 操作・ログ</h1>
<partial name="_ServerTabs" model="Model.Server.ServerId" />
<section class="server-console" id="server-console" data-server-id="@Model.Server.ServerId" data-enabled="@Model.Enabled.ToString().ToLowerInvariant()">
    <h2>運転状態</h2>
    <p id="server-operation-status">プロセス <strong id="server-process-state">@(Model.Runtime?.ProcessState switch { ProcessState.Stopped => "停止中", ProcessState.Starting => "起動中", ProcessState.Running => "稼働中", ProcessState.Stopping => "停止処理中", ProcessState.Unmanaged => "管理外・要確認", _ => "確認不能" })</strong></p>
    @if (Model.Error != null) { <p class="status-note is-warning" role="alert">@Model.Error</p> }
    <div class="status-note operation-guidance">
        <p id="server-availability" role="status" aria-live="polite">@(availability.Reason ?? (availability.CanStart ? "停止中です。起動できます。" : "稼働中です。正常停止または再起動できます。"))</p>
        <a id="server-workflow-link" asp-page="/Workflows" asp-route-workflowId="@availability.WorkflowId" hidden="@(availability.WorkflowId is null)">対象の操作・保守履歴を開く</a>
        <a id="server-operation-reload" asp-page="/Servers/Operations" asp-route-serverId="@Model.Server.ServerId" data-native-navigation hidden>最新の状態を確認</a>
    </div>
    <p class="secondary-text" id="server-latest-operation" hidden="@(latestOperation is null)">@(latestOperation is null ? null : $"直近の操作 {ControlDisplay.OperationName(latestOperation.Kind)} · {ControlDisplay.OperationState(latestOperation.Status)} · {ControlDisplay.Timestamp(latestOperation.CreatedAtUtc)}")</p>
    <form method="post" asp-page-handler="Operate" data-operation-form>
        <input type="hidden" name="serverId" value="@Model.Server.ServerId" />
        <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
        <input type="hidden" name="configRevision" value="@Model.Server.AppliedRevision" data-server-state-field />
        <input type="hidden" name="expectedStateRevision" value="@Model.Runtime?.StateRevision" data-server-state-field />
        <input type="hidden" name="expectedServerSessionId" value="@Model.Runtime?.CurrentSessionId" data-server-state-field />
        <div class="operation-actions">
            <button type="submit" name="kind" value="Start" class="operation-start" aria-describedby="server-availability" disabled="@(!availability.CanStart)">起動</button>
            <button type="submit" name="kind" value="Restart" class="operation-restart" aria-describedby="server-availability" disabled="@(!availability.CanRun)">再起動</button>
            <button type="submit" name="kind" value="Stop" class="operation-stop" aria-describedby="server-availability" disabled="@(!availability.CanStop)">正常停止</button>
        </div>
        <details class="kill-details">
            <summary>強制終了（保存せず終了）</summary>
            <p>ゲームサーバーのプロセスを強制終了します。プレイヤーのKick/Kill操作ではありません。未保存データが失われる可能性があります。通常は「正常停止」を使ってください。</p>
            <p>対象 Session <code id="server-kill-session">@(Model.Runtime?.CurrentSessionId.ToString() ?? "なし")</code></p>
            <label>強制終了の理由 <input name="reason" maxlength="1024" /></label>
            <label><input type="checkbox" name="confirmKill" value="true" /> 表示中のサーバーとSessionを確認し、保存せず強制終了することを了承しました</label>
            <button type="submit" name="kind" value="Kill" class="operation-kill" aria-describedby="server-availability" disabled="@(!availability.CanRun)">プロセスを強制終了</button>
        </details>
    </form>
    <form method="post" asp-page-handler="Operate" data-operation-form id="server-maintenance-start" hidden="@(maintenanceStart is null)">
        <input type="hidden" name="serverId" value="@Model.Server.ServerId" />
        <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
        <input type="hidden" name="reservationId" value="@maintenanceStart?.ReservationId" />
        <input type="hidden" name="configRevision" value="@Model.Server.AppliedRevision" data-server-state-field />
        <input type="hidden" name="expectedStateRevision" value="@Model.Runtime?.StateRevision" data-server-state-field />
        <input type="hidden" name="expectedServerSessionId" value="@Model.Runtime?.CurrentSessionId" data-server-state-field />
        <button type="submit" name="kind" value="Start" class="operation-start" aria-describedby="server-availability" disabled="@(maintenanceStart is null)">@(Model.Server.DesiredRevision != Model.Server.AppliedRevision ? "適用済みの設定で保守起動" : "保守作業の続きとして起動")</button>
    </form>
    <details class="operation-diagnostics">
        <summary>運転の診断情報</summary>
        <p>Session <span id="server-session">@(Model.Runtime?.CurrentSessionId.ToString() ?? "なし")</span></p>
    </details>
</section>
<section class="server-console">
    <h2>ライブログ</h2>
    <p id="log-status" role="status" aria-live="polite">ログと運転状態を3秒ごとに更新します。</p>
    @if (Model.Logs?.Gap == true) { <p>保持期間を超えた行があります。最古 cursor: @Model.Logs.EarliestAvailableCursor</p> }
    @* Cloudflare must leave console text intact so email obfuscation cannot inject a decoder into the page. *@
    <pre id="server-log" tabindex="0" aria-label="サーバーログ" data-server-id="@Model.Server.ServerId" data-session-id="@Model.Logs?.SessionId" data-cursor="@(Model.Logs?.NextCursor ?? 0)"><!--email_off-->@if (Model.Logs is not null) { foreach (var row in Model.Logs.Rows) { @($"[{ControlDisplay.Timestamp(row.OccurredAtUtc)}] {row.Stream}: {row.Text}\n") } }<!--/email_off--></pre>
    <form method="post" asp-page-handler="Operate" data-operation-form class="console-command-form">
        <input type="hidden" name="serverId" value="@Model.Server.ServerId" />
        <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
        <input type="hidden" name="configRevision" value="@Model.Server.AppliedRevision" data-server-state-field />
        <input type="hidden" name="expectedStateRevision" value="@Model.Runtime?.StateRevision" data-server-state-field />
        <input type="hidden" name="expectedServerSessionId" value="@Model.Runtime?.CurrentSessionId" data-server-state-field />
        <label for="server-command">コンソールコマンド</label>
        <div class="console-command-row"><input id="server-command" name="command" maxlength="4096" autocomplete="off" required placeholder="例: say メンテナンスを開始します" /><button type="submit" name="kind" value="ConsoleCommand" aria-describedby="server-availability" disabled="@(!availability.CanRun)">送信</button></div>
    </form>
</section>
<section class="server-console">
    <h2>操作履歴</h2>
    <div class="table-scroll"><table class="data-table"><thead><tr><th>日時</th><th>種別</th><th>状態</th><th>詳細・対処</th></tr></thead><tbody id="server-operation-history">
        @foreach (var operation in Model.Recent)
        {
            <tr><td>@ControlDisplay.Timestamp(operation.CreatedAtUtc)</td><td>@ControlDisplay.OperationName(operation.Kind)</td><td>@ControlDisplay.OperationState(operation.Status)</td><td>
                @if (ControlDisplay.OperationError(operation.ErrorCode) is { } error) { <span>@error</span> }
                @if (operation.WorkflowId != Guid.Empty) { <a class="operation-history-link" asp-page="/Workflows" asp-route-workflowId="@operation.WorkflowId">詳細を開く</a> }
            </td></tr>
        }
    </tbody></table></div>
</section>
@section Scripts { <script src="~/js/server-logs.js" asp-append-version="true" defer></script> }
