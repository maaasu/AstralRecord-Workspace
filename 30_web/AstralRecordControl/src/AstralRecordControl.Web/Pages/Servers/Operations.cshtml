@page "/Servers/{serverId:guid}/Operations"
@model AstralRecordControl.Web.Pages.Servers.OperationsModel
@{ ViewData["Title"] = "Server 操作"; }
<h1>@Model.Server.DisplayName</h1>
<p>プロセス: @(Model.Runtime?.ProcessState.ToString() ?? "状態未取得") / Session: @(Model.Runtime?.CurrentSessionId.ToString() ?? "なし") / 設定: @Model.Server.AppliedRevision</p>
@if (Model.Error != null) { <p role="alert">@Model.Error</p> }
@if (!Model.Enabled) { <p>操作は現在利用できません。共通 gate、Host 接続、設定適用を確認してください。</p> }
else
{
    <form method="post" asp-page-handler="Operate">
        <input type="hidden" name="serverId" value="@Model.Server.ServerId" />
        <input type="hidden" name="requestKey" value="@Model.RequestKey" />
        <input type="hidden" name="configRevision" value="@Model.Server.AppliedRevision" />
        <input type="hidden" name="expectedStateRevision" value="@Model.Runtime!.StateRevision" />
        <input type="hidden" name="expectedServerSessionId" value="@Model.Runtime.CurrentSessionId" />
        <button type="submit" name="kind" value="Start">Start</button>
        <button type="submit" name="kind" value="Stop">Stop</button>
        <button type="submit" name="kind" value="Restart">Restart</button>
        <label>Kill 理由 <input name="reason" maxlength="1024" /></label>
        <label><input type="checkbox" name="confirmKill" value="true" /> 表示中のサーバーとSessionを確認し、保存せず強制終了することを了承しました</label>
        <button type="submit" name="kind" value="Kill">Kill</button>
        <label>Console 命令 <input name="command" maxlength="4096" /></label>
        <button type="submit" name="kind" value="ConsoleCommand">送信</button>
    </form>
    @foreach (var lease in Model.MaintenanceLeases.Where(_ => Model.Runtime!.ProcessState == AstralRecordControl.Contracts.ProcessState.Stopped))
    {
        <form method="post" asp-page-handler="Operate">
            <input type="hidden" name="serverId" value="@Model.Server.ServerId" />
            <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
            <input type="hidden" name="reservationId" value="@lease.ReservationId" />
            <input type="hidden" name="configRevision" value="@Model.Server.AppliedRevision" />
            <input type="hidden" name="expectedStateRevision" value="@Model.Runtime!.StateRevision" />
            <input type="hidden" name="expectedServerSessionId" value="@Model.Runtime.CurrentSessionId" />
            <button type="submit" name="kind" value="Start">@lease.AdapterId 保守 Workflow の Start</button>
        </form>
    }
}
<h2>操作履歴</h2>
<table><thead><tr><th>日時</th><th>種別</th><th>状態</th><th>エラー</th></tr></thead><tbody>
@foreach (var operation in Model.Recent) { <tr><td>@operation.CreatedAtUtc</td><td>@operation.Kind</td><td>@operation.Status</td><td>@operation.ErrorCode</td></tr> }
</tbody></table>
<h2>ログ</h2>
@if (Model.Logs is null) { <p>ログは現在取得できません。</p> }
else
{
    @if (Model.Logs.Gap) { <p>保持期間を超えた行があります。最古 cursor: @Model.Logs.EarliestAvailableCursor</p> }
    <p id="log-status" role="status">ログは3秒ごとに更新します。</p>
    <pre id="server-log" data-server-id="@Model.Server.ServerId" data-session-id="@Model.Logs.SessionId" data-cursor="@Model.Logs.NextCursor">@foreach (var row in Model.Logs.Rows) { @($"[{row.OccurredAtUtc:O}] {row.Stream}: {row.Text}\n") }</pre>
    <a asp-page="Operations" asp-route-serverId="@Model.Server.ServerId" asp-route-afterSequence="@Model.Logs.NextCursor">次のログ</a>
}
@section Scripts { <script src="~/js/server-logs.js" asp-append-version="true" defer></script> }
