@page "/Servers"
@model AstralRecordControl.Web.Pages.Servers.IndexModel
@using AstralRecordControl.Web.Pages.Shared
@{
    ViewData["Title"] = "サーバー台帳";
    var showCreateError = Model.Error != null
        && string.Equals(Model.Request.Method, "POST", StringComparison.OrdinalIgnoreCase)
        && string.Equals(Model.Request.Query["handler"].ToString(), "Create", StringComparison.OrdinalIgnoreCase);
}

<div class="page-heading"><div><h1>サーバー台帳</h1><p>稼働状態を一覧で確認し、対象サーバーの操作へ進みます。</p></div><div class="table-actions"><a class="button-link" asp-page="Index">状態を更新</a><a class="button-link" href="/">概要へ戻る</a></div></div>
<p class="snapshot-note">最終更新 @ControlDisplay.LastSeen(Model.ObservedAtUtc) · PCから30秒以内に届いた状態を表示します。</p>
@if (Model.Error != null) { <p role="alert">@Model.Error</p> }

<section class="page-section" aria-labelledby="server-list-heading">
    <div class="section-heading"><div><h2 id="server-list-heading">登録済みサーバー</h2><p>@Model.Servers.Length 件を登録しています。</p></div></div>
    @if (Model.Servers.Length == 0) {
        <div class="empty-state"><strong>サーバーはまだ登録されていません</strong><p>PCが接続し、rootと実行ファイルが報告された後に登録できます。</p></div>
    } else {
        <div class="table-scroll"><table class="data-table server-register"><thead><tr><th scope="col">サーバー</th><th scope="col">稼働状態</th><th scope="col">配置PC / 種類</th><th scope="col">設定</th><th scope="col">操作</th></tr></thead><tbody>
        @foreach (var server in Model.Servers) {
            var kind = Model.Configuration(server).Kind;
            var status = Model.Status(server);
            <tr><td><strong>@server.DisplayName</strong><span class="entity-key">@server.ServerKey</span></td><td><span class="state-badge @status.CssClass">@status.Label</span><span class="entity-key">@status.Detail</span></td><td>@(Model.Hosts.FirstOrDefault(h => h.HostId == server.HostId)?.DisplayName ?? "PC未確認")<span class="entity-key">@ControlDisplay.Kind(kind)</span></td><td><span class="state-badge @(server.DesiredRevision == server.AppliedRevision ? "is-online" : "is-pending")">@(server.DesiredRevision == server.AppliedRevision ? "適用済み" : "適用待ち")</span><details class="inline-details"><summary>版を表示</summary>希望 @server.DesiredRevision / 適用 @server.AppliedRevision</details></td><td><div class="table-actions">
            @if (kind is ServerKind.Java or ServerKind.Velocity) { <a class="button-link button-link--primary" asp-page="Operations" asp-route-serverId="@server.ServerId">操作・ログ</a> }
            else { <span class="secondary-text">台帳のみ · 起動・停止は未対応</span> }
            <a class="button-link" asp-page="Edit" asp-route-serverId="@server.ServerId">設定・詳細</a>
            </div></td></tr>
        }
        </tbody></table></div>
    }
</section>

<details class="setup-details" open="@(showCreateError ? "open" : null)"><summary>サーバーを登録する</summary><div class="details-body"><p>登録済みPCと、そのAgentが報告したroot・実行ファイルを選択します。VelocityにはJava実行ファイルを使用できます。Bedrockは台帳登録のみ対応しています。</p>
    <form method="post" asp-page-handler="Create">
        <input type="hidden" name="requestKey" value="@Model.RequestKey" /><input type="hidden" name="serverId" value="@Model.ServerId" />
        <label>配置PC <select name="hostId" required><option value="">選択</option>@foreach (var host in Model.Hosts.Where(h => h.Enabled)) { <option value="@host.HostId">@host.DisplayName (@host.HostKey)</option> }</select></label>
        <label>サーバーキー <input name="serverKey" required pattern="[a-z0-9][a-z0-9-]{0,47}" maxlength="48" /></label>
        <label>表示名 <input name="displayName" required maxlength="128" /></label>
        <label>Environment <select name="environmentId"><option value="">なし</option>@foreach (var environment in Model.Environments) { <option value="@environment.EnvironmentId">@environment.DisplayName</option> }</select></label>
        <label>既存システムのサーバーID（任意） <input name="runtimeServerId" maxlength="128" /></label>
        <label>種類 <select name="kind"><option>Java</option><option>Bedrock</option><option>Velocity</option></select></label>
        <label>登録root <select name="managedRootId" required><option value="">選択</option>@foreach (var host in Model.Hosts) { @foreach (var root in Model.Resources(host).Roots) { <option value="@root.Id">@host.HostKey / @root.DisplayName</option> } }</select></label>
        <label>登録実行ファイル <select name="executableId" required><option value="">選択</option>@foreach (var host in Model.Hosts) { @foreach (var executable in Model.Resources(host).Executables) { <option value="@executable.Id">@host.HostKey / @executable.DisplayName (@executable.Kind)</option> } }</select></label>
        <label>root内の相対ディレクトリ <input name="serverDirectory" required placeholder="servers/dev" maxlength="512" /></label>
        <label>引数（1行につき1引数） <textarea name="arguments" rows="5" placeholder="-jar&#10;server.jar&#10;nogui"></textarea></label>
        <label>待受ポート（任意） <input type="number" name="listenPort" min="1" max="65535" /></label>
        <label>停止コマンド（空欄で標準値） <input name="stopCommand" placeholder="Java: stop / Velocity: shutdown" maxlength="4096" /></label>
        <button type="submit">サーバーを登録</button>
    </form>
</div></details>
