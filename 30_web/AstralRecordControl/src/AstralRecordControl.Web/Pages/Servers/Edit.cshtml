@page "/Servers/{serverId:guid}"
@model AstralRecordControl.Web.Pages.Servers.EditModel
@using AstralRecordControl.Contracts
@{
    ViewData["Title"] = Model.Server.DisplayName;
    ViewData["ServerTab"] = "Edit";
    ViewData["ServerManaged"] = Model.Config.Kind == ServerKind.Java;
    ViewData["ServerProcessManaged"] = ServerProcessSupport.IsSupported(Model.Config.Kind);
    var submitted = Model.Submitted;
    var formConfig = submitted?.Config ?? Model.Config;
    var environmentId = submitted is null ? Model.Server.EnvironmentId : submitted.EnvironmentId;
    var runtimeServerId = submitted is null ? Model.Server.RuntimeServerId : submitted.RuntimeServerId;
}
<h1>@Model.Server.DisplayName (@Model.Server.ServerKey)</h1>
<partial name="_ServerTabs" model="Model.Server.ServerId" />
<p>設定の希望版 @Model.Server.DesiredRevision / 適用版 @Model.Server.AppliedRevision。保存後の適用状況は<a asp-page="/Hosts/Index">接続PC</a>で確認できます。</p>
@if (Model.Config.Kind == ServerKind.Velocity) {
    <p class="notice">Velocityは「操作・ログ」から起動・停止できます。Java実行ファイルを選択し、引数に実際のVelocity JARを指定してください。停止コマンドの標準値はshutdownです。</p>
} else if (!ServerProcessSupport.IsSupported(Model.Config.Kind)) {
    <p class="notice">この種類は台帳登録のみ対応しています。Controlからの起動・停止・バックアップは未対応です。台帳の表示を実サーバーの停止確認には使用できません。</p>
}
@if (Model.Error != null) { <p role="alert">@Model.Error</p> }
<form method="post">
    <input type="hidden" name="serverId" value="@Model.Server.ServerId" /><input type="hidden" name="revision" value="@Model.Server.DesiredRevision" />
    <label>表示名 <input name="displayName" value="@(submitted?.DisplayName ?? Model.Server.DisplayName)" required maxlength="128" /></label>
    <label>Environment <select name="environmentId"><option value="">なし</option>@foreach (var environment in Model.Environments) { <option value="@environment.EnvironmentId" selected="@(environment.EnvironmentId == environmentId)">@environment.DisplayName</option> }</select></label>
    <label>runtimeServerId <input name="runtimeServerId" value="@runtimeServerId" maxlength="128" /></label>
    <label>登録root <select name="managedRootId" required>@foreach (var root in Model.Resources.Roots) { <option value="@root.Id" selected="@(root.Id == formConfig.ManagedRootId)">@root.DisplayName</option> }</select></label>
    <label>登録実行ファイル <select name="executableId" required>@foreach (var executable in Model.Resources.Executables.Where(e => ServerProcessSupport.IsExecutableCompatible(Model.Config.Kind, e.Kind))) { <option value="@executable.Id" selected="@(executable.Id == formConfig.ExecutableId)">@executable.DisplayName</option> }</select></label>
    <label>相対ディレクトリ <input name="serverDirectory" value="@formConfig.ServerDirectory" required maxlength="512" /></label>
    <label>引数 (1行につき1引数) <textarea name="arguments" rows="6">@string.Join("\n", formConfig.ArgumentList)</textarea></label>
    <label>Listen port <input type="number" name="listenPort" value="@formConfig.ListenPort" min="1" max="65535" /></label>
    <label>停止コマンド <input name="stopCommand" value="@ServerProcessSupport.EffectiveStopCommand(formConfig)" required maxlength="4096" /></label>
    @if (ServerProcessSupport.IsSupported(formConfig.Kind))
    {
        <label>正常停止の待ち時間（秒） <input type="number" name="stopTimeoutSeconds" value="@formConfig.StopTimeoutSeconds" min="10" max="600" required /></label>
        <p class="secondary-text">この時間内に終了しない場合は「要確認」と表示し、履歴・復旧から状況を確認できます。</p>
    }
    <button type="submit">希望設定を保存</button>
</form>
<details><summary>希望設定 JSON / SHA-256</summary><pre>@Model.Server.DesiredConfigJson</pre><p>@Model.Server.ConfigSha256</p></details>
