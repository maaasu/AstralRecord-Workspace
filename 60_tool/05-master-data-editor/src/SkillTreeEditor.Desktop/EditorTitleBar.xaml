<UserControl x:Class="SkillTreeEditor.Desktop.EditorTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="32" Background="#282c34" Foreground="#cdd3de">
  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#cdd3de"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#404754"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3e628b"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border BorderBrush="#3c424d" BorderThickness="0,0,0,1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Image Source="Assets/AppIcon.ico" Width="20" Height="20" Margin="9,0,7,0"/>
      <TextBlock x:Name="CaptionText" Grid.Column="1" Text="AstralRecord マスタデータエディタ" VerticalAlignment="Center" FontSize="12"/>
      <TextBlock x:Name="WorkspaceText" Grid.Column="2" Foreground="#abb2bf" Margin="14,0,8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/>
      <StackPanel Grid.Column="3" Orientation="Horizontal">
        <Button Content="表示" Click="Views_Click" ToolTip="ビューの表示・配置"/>
        <Button x:Name="WorkspaceButton" Content="変更" Click="Workspace_Click" ToolTip="ワークスペースを変更"/>
      </StackPanel>
      <Button Grid.Column="4" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="44" Click="Minimize_Click" AutomationProperties.Name="最小化"/>
      <Button Grid.Column="5" x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="44" Click="Maximize_Click" AutomationProperties.Name="最大化・元に戻す"/>
      <Button Grid.Column="6" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="44" Click="Close_Click" AutomationProperties.Name="閉じる"/>
    </Grid>
  </Border>
</UserControl>
