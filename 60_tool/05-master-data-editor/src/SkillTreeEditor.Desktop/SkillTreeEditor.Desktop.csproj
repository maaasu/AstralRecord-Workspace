<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AstralRecordMasterEditor</AssemblyName>
    <RootNamespace>SkillTreeEditor.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Server is hosted as a library in this process; its standalone executable is not launched. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <SpaRoot>..\SkillTreeEditor.Client\</SpaRoot>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <ProjectReference Include="..\SkillTreeEditor.Server\SkillTreeEditor.Server.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" GeneratePathProperty="true" />
    <PackageReference Include="QRCoder" Version="1.8.1" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\Invoke-EditorToolJob.ps1" Link="tool-host\Invoke-EditorToolJob.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Web_WebView2)\LICENSE.txt" Link="licenses\WebView2-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Web_WebView2)\NOTICE.txt" Link="licenses\WebView2-NOTICE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgQRCoder)\LICENSE.txt" Link="licenses\QRCoder-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishDesktopFrontend" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(SpaRoot)dist\index.html')" Text="先に SkillTreeEditor.Client で npm ci と npm run build を実行してください。" />
    <ItemGroup>
      <DesktopFrontend Include="$(SpaRoot)dist\**" />
      <ResolvedFileToPublish Include="@(DesktopFrontend->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
