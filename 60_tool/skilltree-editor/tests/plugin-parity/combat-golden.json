  "cases": [
    { "id": "melee_neutral", "input": { "attack": 40, "mobDefense": 8, "accuracy": 95, "critRate": 0, "hitRoll": 0 }, "expected": { "finalDamage": 35.72096105187394, "hitChance": 95.0, "critical": false, "evaded": false } },
    { "id": "melee_critical", "input": { "attack": 40, "mobDefense": 8, "accuracy": 95, "critRate": 100, "critDamage": 150, "hitRoll": 0, "critRoll": 0 }, "expected": { "finalDamage": 53.581441577810914, "hitChance": 95.0, "critical": true, "evaded": false } },
    { "id": "melee_miss", "input": { "attack": 40, "mobDefense": 8, "accuracy": 95, "hitRoll": 99 }, "expected": { "finalDamage": 0.0, "hitChance": 95.0, "critical": false, "evaded": true } },
    { "id": "timing", "input": { "cooldownBaseTicks": 17, "cooldownReduction": 50, "attackBaseTicks": 9, "attackSpeed": 175 }, "expected": { "cooldownTicks": 9, "attackIntervalTicks": 6 } },
    { "id": "cast_reduction_stacked", "input": { "primaryReduction": 20, "additionalReduction": 40, "baseCastTicks": 9 }, "expected": { "multiplier": 0.5, "castTicks": 5 } },
    { "id": "cast_reduction_clamped", "input": { "primaryReduction": 80, "additionalReduction": -10, "cooldownBaseTicks": 17 }, "expected": { "multiplier": 0.5, "cooldownTicks": 9 } },
    { "id": "degradation_delay", "input": { "delayAttacks": 2, "beforeAttackCount": 6, "firstAttackCount": 7 }, "expected": { "beforeStage": 0, "firstStage": 1, "damageMultiplier": 0.9, "speedMultiplier": 1.0 } },
    { "id": "degradation_cap", "input": { "attackCount": 100, "stage": 11 }, "expected": { "stage": 11, "damageMultiplier": 0.0, "speedMultiplier": 0.5 } },
    { "id": "degradation_expiry", "input": { "fifthAttackAtMillis": 1000, "nextAttackAfterMillis": 10001, "classId": "swordsman" }, "expected": { "fifthStage": 1, "afterExpiryStage": 0 } },
    { "id": "gear_enhance_enchant_rune", "input": { "enhanceFlatMin": 2, "enhanceFlatMax": 3, "enchantFlat": 4, "runeFlat": 5, "enchantScalar": 2 }, "expected": { "min": 22, "max": 24, "scalarActive": true } },
    { "id": "gear_last_scalar_negative_range", "input": { "rollMin": -10, "rollMax": 20, "firstScalar": 2, "lastScalar": 3 }, "expected": { "min": -30, "max": 60, "firstOverridden": true } },
    { "id": "mob_level_profile", "input": { "baseLevel": 1, "baseHealth": 10, "levelTwoHealth": 20, "levelTwoExp": 20, "fallbackRequestLevel": 99 }, "expected": { "defaultLevel": 1, "levelTwoHealth": 20, "levelTwoExp": 20, "fallbackLevel": 1 } },
    { "id": "mob_shield_profile", "input": { "baseShieldMax": 10, "baseRechargeSeconds": 15, "levelTwoShieldMax": 20, "levelTwoRechargeAmount": 25 }, "expected": { "active": true, "rechargeable": true, "max": 20, "rechargeSeconds": 15, "rechargeAmount": 25 } },
    { "id": "direct_drop_luck", "input": { "rate": 80, "luck": 10, "dropRatePercent": 100, "luckAffected": [true, false] }, "expected": { "luckAffectedRate": 88, "unaffectedRate": 80 } },
    { "id": "exp_level_gap_rate", "input": { "baseExp": 100, "playerLevel": 30, "mobLevel": 10, "experienceGainRate": 125 }, "expected": { "levelMultiplier": 0.1, "scaledExp": 10, "afterRateExp": 13 } },
    { "id": "exp_half_round", "input": { "baseExp": 7, "experienceGainRate": 50 }, "expected": { "baseExp": 7, "afterRateExp": 4, "neutralExp": 7 } },
    { "id": "orb_enhance_success", "input": { "fromLevel": 3, "nextLevel": 4, "successRate": 1, "failAction": "NONE" }, "expected": { "succeeded": true, "fromLevel": 3, "resultLevel": 4 } },
    { "id": "orb_enhance_fail_none", "input": { "fromLevel": 3, "nextLevel": 4, "successRate": 0, "failAction": "NONE" }, "expected": { "succeeded": false, "fromLevel": 3, "resultLevel": 3 } },
    { "id": "orb_enhance_fail_decrease", "input": { "fromLevel": 3, "nextLevel": 4, "successRate": 0, "failAction": "DECREASE_ONE" }, "expected": { "succeeded": false, "fromLevel": 3, "resultLevel": 2 } },
    { "id": "orb_enhance_fail_set", "input": { "fromLevel": 3, "nextLevel": 4, "successRate": 0, "failAction": "SET_LEVEL", "failTargetLevel": 1 }, "expected": { "succeeded": false, "fromLevel": 3, "resultLevel": 1 } }
  ]
}
