    "anim_type": "flip_book",
    "initial_uv": [ 0, 0 ],
    "frame_count": 12,
    "frame_step": 24,
    "fps": 10,
    "looping": true,
    "easing": "linear"
  },
  "hotbar_slot_selected_image": {
    "texture": "textures/ui/astralrecord/hotbar_selection",
    "uv_size": [ 24, 24 ],
    "uv": "@hud.astral_hotbar_selection_animation"
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "astralrecord_profile_hud@hud.astralrecord_profile_hud": {} }
        ]
      }
    ]
  },
  "hud_tip_text": {
    "bindings": [
      {
        "binding_name": "#tip_text",
        "binding_condition": "always"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#tip_text = (#tip_text - 'geyseropt:astralrecord_profile_hud_images:'))",
        "target_property_name": "#visible"
      }
    ]
  },
  "astralrecord_profile_hud": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$profile_prefix": "geyseropt:astralrecord_profile_hud_images:",
    "controls": [
      {
        "profile_data": {
          "type": "panel",
          "size": [ 0, 0 ],
          "bindings": [
            {
              "binding_name": "#tip_text",
              "binding_condition": "always"
            },
            {
              "binding_name": "#tip_text",
              "binding_name_override": "#preserved_text",
              "binding_condition": "visibility_changed"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#tip_text = #preserved_text) and (('%.42s' * #tip_text) = $profile_prefix))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "profile_level_icon": {
          "type": "image",
          "texture": "textures/ui/astralrecord/profile_level",
          "color": [ 0.55, 0.88, 0.88 ],
