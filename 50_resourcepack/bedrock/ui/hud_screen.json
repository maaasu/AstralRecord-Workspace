          "anchor_from": "bottom_middle",
          "anchor_to": "top_left",
          "layer": 31,
          "visible": false,
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "profile_data",
              "resolve_sibling_scope": true,
              "source_property_name": "((('%.4s' * (#preserved_text - $profile_prefix)) = '|p0|') or (('%.4s' * (#preserved_text - $profile_prefix)) = '|p1|'))",
