{
  "namespace": "hud",
  "astral_hotbar_selection_animation": {
    "anim_type": "flip_book",
    "initial_uv": [ 0, 0 ],
    "frame_count": 12,
    "frame_step": 24,
    "fps": 10,
    "looping": true,
    "easing": "linear"
  },
  "hotbar_slot_selected_image": {
    "texture": "textures/ui/astralrecord/hotbar_selection",
    "uv_size": [ 24, 24 ],
    "uv": "@hud.astral_hotbar_selection_animation"
  },
  "hud_actionbar_text": {
    "size": [ "100%c + 18px", "100%c + 5px" ],
    "texture": "textures/ui/astralrecord/actionbar_plate",
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "left_ornament@astralrecord_hud.actionbar_ornament": { "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [ 3, 0 ] } },
          { "right_ornament@astralrecord_hud.actionbar_ornament": { "anchor_from": "right_middle", "anchor_to": "right_middle", "offset": [ -3, 0 ] } }
        ]
      }
    ]
  },
  "root_panel/hud_actionbar_text_area": {
    "factory": {
      "name": "hud_actionbar_text_factory",
      "control_ids": {
        "hud_actionbar_text": "hud_actionbar_text@hud.astralrecord_actionbar_route"
      }
    }
  },
  "astralrecord_actionbar_route": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "$astralrecord_actionbar_payload": "$actionbar_text",
    "$astralrecord_actionbar_anims": [],
    "variables": [
      {
        "requires": "(not ($astralrecord_actionbar_payload = ($astralrecord_actionbar_payload - 'arw2|')))",
        "$astralrecord_actionbar_anims": [
          "@hud.astralrecord_action_ring_expiry"
        ]
      }
    ],
    "anims": "$astralrecord_actionbar_anims",
    "controls": [
      {
        "normal_actionbar@hud.hud_actionbar_text": {
          "ignored": "(not ($astralrecord_actionbar_payload = ($astralrecord_actionbar_payload - 'arw2|')))"
        }
      },
      {
        "action_ring@astralrecord_action_ring.popup": {
          "ignored": "($astralrecord_actionbar_payload = ($astralrecord_actionbar_payload - 'arw2|'))"
        }
      }
    ]
  },
  "astralrecord_action_ring_expiry": {
    "anim_type": "wait",
    "duration": 1.2,
    "destroy_at_end": "hud_actionbar_text",
    "end_event": "hud_actionbar_text_complete"
  },
  "root_panel/chat_stack": {
    "modifications": [
      {
        "operation": "insert_before",
        "value": [
          {
            "astralrecord_quest_hud@astralrecord_quest_hud.panel": {}
          }
        ],
        "control_name": "chat_panel"
      }
    ]
  },
  "hud_tip_text": {
    "bindings": [
      {
        "binding_name": "#tip_text",
        "binding_condition": "always"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (('%.33s' * #tip_text) = 'geyseropt:astralrecord_quest_hud:'))",
        "target_property_name": "#visible"
      }
    ]
  }
}
