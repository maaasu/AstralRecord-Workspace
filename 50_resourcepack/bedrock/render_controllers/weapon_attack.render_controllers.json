{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.astralrecord.weapon_attack": {
      "arrays": {
        "textures": {
          "Array.weapons": [
            "Texture.sword",
            "Texture.hammer",
            "Texture.spear",
            "Texture.bow",
            "Texture.wand",
            "Texture.staff"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [{"*": "Material.default"}],
      "textures": [
        "Array.weapons[math.clamp(query.property('astralrecord:style'), 0, 5)]"
      ],
      "color": {
        "r": 1.0,
        "g": 1.0,
        "b": 1.0,
        "a": "math.clamp(1.0 - math.max(0.0, query.life_time - 0.15) / 0.10, 0.0, 1.0)"
      }
    }
  }
}
