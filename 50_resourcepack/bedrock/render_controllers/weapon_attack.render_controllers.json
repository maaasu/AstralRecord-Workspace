{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.astralrecord.weapon_attack": {
      "arrays": {
        "textures": {
          "Array.weapons": [
            "Texture.sword",
            "Texture.hammer",
            "Texture.spear",
            "Texture.bow",
            "Texture.wand",
            "Texture.staff",
            "Texture.bow_trail",
            "Texture.wand_trail",
            "Texture.staff_trail",
            "Texture.bow_impact",
            "Texture.wand_impact",
            "Texture.staff_impact"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [{"*": "Material.default"}],
      "textures": [
        "Array.weapons[math.clamp(query.property('astralrecord:style'), 0, 11)]"
      ],
      "ignore_lighting": true,
      "part_visibility": [
        {"frame_0": "variable.frame == 0"},
        {"frame_1": "variable.frame == 1"},
        {"frame_2": "variable.frame == 2"},
        {"frame_3": "variable.frame == 3"},
        {"frame_4": "variable.frame == 4"},
        {"frame_5": "variable.frame == 5"}
      ]
    }
  }
}
