{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "astralrecord:astra_sword",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/items/astra_sword",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.astralrecord.astra_sword"
      },
      "animations": {
        "first_person": "animation.astralrecord.astra_sword.first_person",
        "third_person": "animation.astralrecord.astra_sword.third_person",
        "attack": "animation.astralrecord.astra_sword.attack"
      },
      "scripts": {
        "pre_animation": [
          "variable.nox_swing = math.clamp((context.owning_entity->variable.attack_time) ?? 0.0, 0.0, 1.0);"
        ],
        "animate": [
          {
            "first_person": "context.is_first_person"
          },
          {
            "third_person": "!context.is_first_person"
          },
          {
            "attack": "context.item_slot == 'main_hand' && variable.nox_swing > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
