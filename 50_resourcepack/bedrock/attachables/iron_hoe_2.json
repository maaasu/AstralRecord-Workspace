        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/items/iron_hoe_2",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.astralrecord.iron_hoe_2"
      },
      "animations": {
        "first_person": "animation.astralrecord.iron_hoe_2.first_person",
        "first_person_off": "animation.astralrecord.iron_hoe_2.first_person_off",
        "third_person": "animation.astralrecord.iron_hoe_2.third_person"
      },
      "scripts": {
        "animate": [
          {
            "first_person": "context.is_first_person && context.item_slot == 'main_hand'"
          },
          {
            "first_person_off": "context.is_first_person && context.item_slot == 'off_hand'"
          },
          {
            "third_person": "!context.is_first_person"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
