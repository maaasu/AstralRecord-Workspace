{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "astralrecord:melkor_hood",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/items/melkor_hood",
        "enchanted": "textures/misc/enchanted_item_glint",
        "armor": "textures/models/armor/melkor_hood"
      },
      "geometry": {
        "default": "geometry.astralrecord.melkor_hood",
        "worn": "geometry.astralrecord.melkor_hood.worn"
      },
      "animations": {
        "first_person": "animation.astralrecord.melkor_hood.first_person",
        "third_person": "animation.astralrecord.melkor_hood.third_person",
        "attack": "animation.astralrecord.melkor_hood.attack"
      },
      "scripts": {
        "pre_animation": [
          "variable.nox_swing = math.clamp((context.owning_entity->variable.attack_time) ?? 0.0, 0.0, 1.0);"
        ],
        "animate": [
          {
            "first_person": "context.is_first_person"
          },
          {
            "third_person": "!context.is_first_person"
          },
          {
            "attack": "context.item_slot == 'main_hand' && variable.nox_swing > 0.0"
          }
        ]
      },
      "render_controllers": [
        {
          "controller.render.item_default": "context.item_slot == 'main_hand' || context.item_slot == 'off_hand'"
        },
        {
          "controller.render.astralrecord.armor_worn": "context.item_slot != 'main_hand' && context.item_slot != 'off_hand'"
        }
      ]
    }
  }
}
