{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "astralrecord:fang_shield",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/items/fang_shield",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.astralrecord.fang_shield"
      },
      "animations": {
        "first_person": "animation.astralrecord.fang_shield.first_person",
        "first_person_off": "animation.astralrecord.fang_shield.first_person_off",
        "first_person_block": "animation.astralrecord.fang_shield.first_person_block",
        "first_person_off_block": "animation.astralrecord.fang_shield.first_person_off_block",
        "third_person": "animation.astralrecord.fang_shield.third_person"
      },
      "scripts": {
        "pre_animation": [
          "variable.blocking_main = query.blocking && !query.is_item_name_any('slot.weapon.offhand', 'minecraft:shield', 'astralrecord:fang_shield');"
        ],
        "animate": [
          {
            "first_person": "context.is_first_person && context.item_slot == 'main_hand' && !variable.blocking_main"
          },
          {
            "first_person_off": "context.is_first_person && context.item_slot == 'off_hand' && !query.blocking"
          },
          {
            "first_person_block": "context.is_first_person && context.item_slot == 'main_hand' && variable.blocking_main"
          },
          {
            "first_person_off_block": "context.is_first_person && context.item_slot == 'off_hand' && query.blocking"
          },
          {
            "third_person": "!context.is_first_person"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
