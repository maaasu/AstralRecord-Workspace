{
  "format_version": "1.8.0",
  "animations": {
    "animation.astralrecord.action_ring": {
      "loop": true,
      "bones": {
        "yaw": {
          "rotation": [
            0,
            "query.property('astralrecord:ring_yaw') - query.body_y_rotation",
            0
          ]
        },
        "pitch": {
          "rotation": [
            "query.property('astralrecord:ring_pitch')",
            0,
            0
          ]
        },
        "wheel": {
          "rotation": [
            0,
            0,
            "query.property('astralrecord:ring_roll')"
          ],
          "scale": [
            "query.property('astralrecord:ring_size')",
            "query.property('astralrecord:ring_size')",
            "query.property('astralrecord:ring_size')"
          ]
        }
      }
    }
  }
}
