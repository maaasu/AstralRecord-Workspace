{
  "format_version": "1.8.0",
  "animations": {
    "animation.astralrecord.skill_effect.motion": {
      "loop": true,
      "bones": {
        "billboard": {
          "rotation": [
            "query.camera_rotation(0)",
            "query.camera_rotation(1) - query.body_y_rotation",
