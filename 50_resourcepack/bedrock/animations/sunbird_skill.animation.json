{
  "format_version": "1.8.0",
  "animations": {
    "animation.astralrecord.sunbird_skill.shape": {
      "loop": true,
      "bones": {
        "root": {
          "scale": [
            "query.property('astralrecord:width')",
            "query.property('astralrecord:height')",
            "query.property('astralrecord:length')"
          ]
        },
        "sparks": {
          "scale": [
            "variable.spark_radius",
            "variable.spark_height",
            "variable.spark_radius"
          ],
          "rotation": [
            0,
            "variable.style == 4 ? -variable.pulse * 35.0 : variable.pulse * 40.0",
            0
          ]
        },
        "crown": {
          "scale": [
            "math.lerp(0.75, 0.42, variable.travel)",
            "0.45 + math.sin(variable.travel * 180.0) * 0.95",
            "math.lerp(0.75, 0.42, variable.travel)"
          ]
        },
        "sweep": {
          "position": [
            0,
            0,
            "math.lerp(5.0, -5.0, variable.style == 5 ? variable.travel : variable.pulse)"
          ]
        },
        "wake": {
          "scale": [
            1,
            1,
            "math.lerp(0.30, 1.60, variable.travel)"
          ],
          "position": [
            0,
            0,
            "math.lerp(5.6, -4.8, variable.travel)"
          ]
        }
      }
    }
  }
}
