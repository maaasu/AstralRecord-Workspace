{
  "format_version": "1.8.0",
  "animations": {
    "animation.astralrecord.sunbird_skill.shape": {
      "loop": true,
      "bones": {
        "root": {
          "scale": [
            "query.property('astralrecord:width')",
            "query.property('astralrecord:height')",
            "query.property('astralrecord:length')"
          ]
        },
        "sparks": {
          "scale": [
            "variable.spark_radius",
            "variable.spark_height",
            "variable.spark_radius"
          ],
          "rotation": [
            0,
            "(variable.style == 4 ? -1.0 : 1.0) * math.sin(variable.pulse_angle) * 16.0",
            0
          ]
        },
        "crown": {
          "scale": [
            "math.lerp(0.59, 0.38, variable.pulse_eased)",
            "0.38 + math.sin(variable.travel * 180.0) * 0.91",
            "math.lerp(0.59, 0.38, variable.pulse_eased)"
          ]
        },
        "sweep": {
          "position": [
            0,
            0,
            "math.lerp(4.9, -4.9, variable.style == 5 ? variable.pulse_eased : variable.pulse)"
          ]
        },
        "wake": {
          "scale": [
            1,
            1,
            "math.lerp(0.36528497, 1.45, variable.pulse_eased)"
          ],
          "position": [
            0,
            0,
            "math.lerp(4.9, -4.9, variable.pulse_eased)"
          ]
        },
        "rib_wave": {
          "scale": [
            "math.lerp(0.25, 1.07, variable.pulse_eased)",
            "0.40 + 0.59 * math.sin(variable.travel * 180.0)",
            "math.lerp(0.25, 1.07, variable.pulse_eased)"
          ],
          "rotation": [
            0,
            "variable.pulse_eased * 11.0",
            0
          ]
        }
      }
    }
  }
}
