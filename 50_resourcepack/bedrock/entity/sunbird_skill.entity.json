{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "astralrecord:sunbird_skill",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/sunbird_skill"
      },
      "geometry": {
        "warning_circle": "geometry.astralrecord.sunbird_warning_circle",
        "warning_line": "geometry.astralrecord.sunbird_warning_line",
        "warning_boundary": "geometry.astralrecord.sunbird_warning_boundary",
        "impact": "geometry.astralrecord.sunbird_impact",
        "warning_safe": "geometry.astralrecord.sunbird_warning_safe",
        "impact_line": "geometry.astralrecord.sunbird_impact_line"
      },
      "animations": {
        "shape": "animation.astralrecord.sunbird_skill.shape"
      },
      "scripts": {
        "pre_animation": [
          "variable.style = query.property('astralrecord:style');",
          "variable.pulse_angle = math.mod(query.life_time * 300.0, 360.0);",
          "variable.pulse = 0.5 - 0.5 * math.cos(variable.pulse_angle);",
          "variable.travel = math.clamp(query.life_time / 0.34, 0.0, 1.0);",
          "variable.pulse_eased = variable.travel * variable.travel * (3.0 - 2.0 * variable.travel);",
          "variable.spark_radius = variable.style == 3 ? math.lerp(0.22, 1.13, variable.pulse_eased) : (variable.style == 2 ? 1.0 : (variable.style == 4 ? math.lerp(0.96, 0.58, variable.pulse) : math.lerp(0.64, 1.0, variable.pulse)));",
          "variable.spark_height = variable.style == 3 ? 0.28 + 0.98 * math.sin(variable.travel * 180.0) : 0.58 + 0.47 * variable.pulse;"
        ],
        "animate": [
          "shape"
        ]
      },
      "render_controllers": [
        "controller.render.astralrecord.sunbird_skill"
      ]
    }
  }
}
