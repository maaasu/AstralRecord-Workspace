{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "astralrecord:sunbird_skill",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/sunbird_skill"
      },
      "geometry": {
        "warning_circle": "geometry.astralrecord.sunbird_warning_circle",
        "warning_line": "geometry.astralrecord.sunbird_warning_line",
        "warning_boundary": "geometry.astralrecord.sunbird_warning_boundary",
        "impact": "geometry.astralrecord.sunbird_impact",
        "warning_safe": "geometry.astralrecord.sunbird_warning_safe",
        "impact_line": "geometry.astralrecord.sunbird_impact_line"
      },
      "animations": {
        "shape": "animation.astralrecord.sunbird_skill.shape"
      },
      "scripts": {
        "pre_animation": [
          "variable.style = query.property('astralrecord:style');",
          "variable.pulse = math.mod(query.life_time, 0.6) / 0.6;",
          "variable.travel = math.clamp(query.life_time / 0.32, 0.0, 1.0);",
          "variable.spark_radius = variable.style == 3 ? math.lerp(0.18, 1.16, variable.travel) : (variable.style == 2 ? 1.0 : (variable.style == 4 ? math.lerp(1.0, 0.46, variable.pulse) : math.lerp(0.36, 1.03, variable.pulse)));",
          "variable.spark_height = variable.style == 3 ? 0.45 + 0.95 * math.sin(variable.travel * 180.0) : 0.55 + 0.85 * math.sin(variable.pulse * 180.0);"
        ],
        "animate": [
          "shape"
        ]
      },
      "render_controllers": [
        "controller.render.astralrecord.sunbird_skill"
      ]
    }
  }
}
