{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "astralrecord:combat_reward_plaque",
      "materials": { "default": "entity_emissive_alpha" },
      "textures": {
        "normal": "textures/entity/combat_reward_plaque/normal",
        "rare": "textures/entity/combat_reward_plaque/rare"
      },
      "geometry": { "default": "geometry.astralrecord.combat_reward_plaque" },
      "animations": { "layout": "animation.astralrecord.combat_reward_plaque.layout" },
      "scripts": {
        "pre_animation": [
          "variable.middle_height = 1.6 + 2.2624 * query.property('astralrecord:reward_lines');",
          "variable.age = query.life_time;",
          "variable.enter = math.clamp(variable.age / 0.5, 0.0, 1.0);",
          "variable.enter = 1.0 - (1.0 - variable.enter) * (1.0 - variable.enter) * (1.0 - variable.enter);",
          "variable.exit = math.clamp((variable.age - 5.5) / 0.5, 0.0, 1.0);",
          "variable.exit = variable.exit * variable.exit * (3.0 - 2.0 * variable.exit);",
          "variable.frame_y = 7.4 + 0.6 * variable.enter + 0.4 * variable.exit;",
          "variable.frame_scale = 0.98 + 0.02 * variable.enter - 0.015 * variable.exit;",
          "variable.alpha = (0.58 + 0.42 * variable.enter) * (1.0 - variable.exit);",
          "variable.corner_glint = math.min(math.clamp((variable.age - 0.62) / 0.26, 0.0, 1.0), math.clamp((1.30 - variable.age) / 0.42, 0.0, 1.0));",
          "variable.corner_glint = variable.corner_glint * variable.corner_glint * (3.0 - 2.0 * variable.corner_glint);"
        ],
        "animate": [ "layout" ]
      },
      "render_controllers": [ "controller.render.astralrecord.combat_reward_plaque" ]
    }
  }
}
