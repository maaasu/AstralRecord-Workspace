      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "sword": "textures/entity/weapon_attack/sword",
        "hammer": "textures/entity/weapon_attack/hammer",
        "spear": "textures/entity/weapon_attack/spear",
        "bow": "textures/entity/weapon_attack/bow",
        "wand": "textures/entity/weapon_attack/wand",
        "staff": "textures/entity/weapon_attack/staff",
        "bow_trail": "textures/entity/weapon_attack/bow_trail",
        "wand_trail": "textures/entity/weapon_attack/wand_trail",
        "staff_trail": "textures/entity/weapon_attack/staff_trail",
        "bow_impact": "textures/entity/weapon_attack/bow_impact",
        "wand_impact": "textures/entity/weapon_attack/wand_impact",
        "staff_impact": "textures/entity/weapon_attack/staff_impact"
      },
      "geometry": {
        "default": "geometry.astralrecord.weapon_attack"
      },
      "properties": {
        "astralrecord:style": {
          "type": "int",
