{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "astralrecord:weapon_attack",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "sword": "textures/entity/weapon_attack/sword",
        "hammer": "textures/entity/weapon_attack/hammer",
        "spear": "textures/entity/weapon_attack/spear",
        "bow": "textures/entity/weapon_attack/bow",
        "wand": "textures/entity/weapon_attack/wand",
        "staff": "textures/entity/weapon_attack/staff"
      },
      "geometry": {
        "default": "geometry.astralrecord.weapon_attack"
      },
      "properties": {
        "astralrecord:style": {
          "type": "int",
          "range": [0, 5],
          "default": 0,
          "client_sync": true
        }
      },
      "animations": {
        "motion": "animation.astralrecord.weapon_attack.motion"
      },
      "scripts": {
        "initialize": ["variable.age = 0.0;"],
        "pre_animation": [
          "variable.frame = math.clamp(math.floor(variable.age * 20.0), 0, 5);",
          "variable.age = variable.age + query.delta_time;"
        ],
        "animate": ["motion"]
      },
      "render_controllers": ["controller.render.astralrecord.weapon_attack"]
    }
  }
}
