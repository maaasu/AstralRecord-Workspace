      "scripts": {
        "initialize": ["variable.age = 0.0;"],
        "pre_animation": [
          "variable.style = query.property('astralrecord:style');",
          "variable.sprite_scale = (variable.style == 0) * 1.55 + (variable.style == 1) * 1.9 + (variable.style == 2) * 1 + (variable.style == 3) * 1.1 + (variable.style == 4) * 1.15 + (variable.style == 5) * 1.45 + (variable.style == 6) * 1 + (variable.style == 7) * 1 + (variable.style == 8) * 1.25 + (variable.style == 9) * 1.35 + (variable.style == 10) * 1.45 + (variable.style == 11) * 1.8;",
          "variable.frame = math.clamp(math.floor(variable.age * 20.0), 0, 5);",
          "variable.age = variable.age + query.delta_time;"
        ],
        "animate": ["motion"]
      },
      "render_controllers": ["controller.render.astralrecord.weapon_attack"]
    }
  }
