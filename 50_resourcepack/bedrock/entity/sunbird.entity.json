{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "astralrecord:sunbird",
      "materials": {
        "default": "entity_alphatest",
        "guard": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/sunbird"
      },
      "geometry": {
        "default": "geometry.astralrecord.sunbird"
      },
      "animations": {
        "body_scale": "animation.astralrecord.sunbird.body_scale",
        "idle": "animation.astralrecord.sunbird.idle",
        "move": "animation.astralrecord.sunbird.move",
        "cast": "animation.astralrecord.sunbird.cast",
        "strike": "animation.astralrecord.sunbird.strike",
        "guard": "animation.astralrecord.sunbird.guard",
        "motion": "controller.animation.astralrecord.sunbird"
      },
      "scripts": {
        "pre_animation": [
          "variable.motion = query.has_property('astralrecord:motion') ? query.property('astralrecord:motion') : (query.is_on_ground ? 0 : 1);",
          "variable.invulnerable = query.has_property('astralrecord:invulnerable') ? query.property('astralrecord:invulnerable') : 0;"
        ],
        "animate": [
          "body_scale",
          "motion",
          {
            "guard": "variable.invulnerable"
          }
        ]
      },
      "render_controllers": [
        "controller.render.astralrecord.sunbird"
      ]
    }
  }
}
