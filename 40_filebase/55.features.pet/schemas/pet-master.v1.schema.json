{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AstralRecord ペットマスター v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "rules",
    "experience",
    "species"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "title": "スキーマバージョン"
    },
    "id": {
      "const": "pets",
      "title": "ID"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxLevel",
        "wildMaxTier",
        "breedMaxTier",
        "skillSlotLevels",
        "breedMinLevel",
        "breedCooldownHours",
        "mutationChance",
        "wildPotentialChance",
        "potentialGrowthMultiplier",
        "potentialCountWeights",
        "maleChance",
        "eggDropChance",
        "sizeGrowth",
        "autonomousAttackRange",
        "threatMultiplier",
        "reviveOrbItemId",
        "facilityId",
        "breedMaterials",
        "reviveMaterials"
      ],
      "properties": {
        "maxLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "title": "最大成長度"
        },
        "wildMaxTier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "title": "野生の最大ティア"
        },
        "breedMaxTier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "title": "配合の最大ティア"
        },
        "skillSlotLevels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "minItems": 3,
          "maxItems": 3,
          "title": "スキル枠の解放成長度",
          "description": "3枠の解放成長度を昇順で指定する。最初の枠は成長度1。"
        },
        "breedMinLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "title": "配合に必要な成長度",
          "description": "2枠目の解放成長度以上にする。"
        },
        "breedCooldownHours": {
          "type": "number",
          "minimum": 0,
          "title": "配合の待機時間（時間）",
          "description": "両親に設定する待機時間。API契約に合わせ正の整数時間。"
        },
        "mutationChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "上位ティアへ変異する確率"
        },
        "wildPotentialChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "野生で潜在能力を持つ確率",
          "description": "各ステータスについて独立抽選する確率。"
        },
        "potentialGrowthMultiplier": {
          "type": "number",
          "minimum": 1,
          "title": "潜在能力の成長倍率",
          "description": "成長増分だけを2倍にする。基礎個体値には適用しない。"
        },
        "potentialCountWeights": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3,
          "title": "潜在数の継承抽選重み",
          "description": "親の多い潜在数から−1個・維持・＋1個の順。整数の重みを指定する。"
        },
        "maleChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "オスの確率"
        },
        "eggDropChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "卵のドロップ確率",
          "description": "敵討伐1回に対する確率。0.0001は0.01%。"
        },
        "sizeGrowth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initialScale", "matureScale", "matureLevel"],
          "properties": {
            "initialScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 2, "title": "初期の外見サイズ倍率" },
            "matureScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 2, "title": "成体の外見サイズ倍率" },
            "matureLevel": { "type": "integer", "minimum": 2, "maximum": 100, "title": "成体サイズに達する成長度" }
          },
          "title": "成長による外見サイズ補正",
          "description": "個体の基礎sizeへ掛ける倍率。初期から成体まで線形補間し、その後は固定する。"
        },
        "autonomousAttackRange": {
          "type": "number", "minimum": 1, "maximum": 32,
          "title": "自律攻撃の索敵距離", "description": "召喚ペットの周囲で敵を探す半径（ブロック）。主人から24ブロック以内で追跡する。"
        },
        "threatMultiplier": {
          "type": "number", "minimum": 0, "maximum": 1,
          "title": "ペットの脅威度倍率", "description": "ペット攻撃のHP/Shield由来の脅威度へ一度だけ掛ける倍率。"
        },
        "reviveOrbItemId": {
          "type": "string",
          "pattern": "^item:[0-9]{2}[a-z][0-9]{5}$",
          "title": "復活オーブのアイテム参照",
          "description": "item:参照。orb.effect.typeがPET_REVIVEのオーブに限定する。"
        },
        "facilityId": {
          "type": "string",
          "minLength": 1,
          "title": "ペット施設のNPC ID",
          "description": "NPCマスターのid。guiのtype: PET_CENTERを持つ施設に限定する。"
        },
        "breedMaterials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemId",
              "quantity"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "pattern": "^item:[0-9]{2}[a-z][0-9]{5}$",
                "title": "素材のアイテム参照",
                "description": "item:参照。素材カテゴリのマスターを指定する。"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "title": "必要数量"
              }
            }
          },
          "minItems": 0,
          "title": "配合で消費する素材"
        },
        "reviveMaterials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemId",
              "quantity"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "pattern": "^item:[0-9]{2}[a-z][0-9]{5}$",
                "title": "素材のアイテム参照",
                "description": "item:参照。素材カテゴリのマスターを指定する。"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "title": "必要数量"
              }
            }
          },
          "minItems": 0,
          "title": "施設復活で消費する素材"
        }
      },
      "title": "ペット共通ルール"
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "quadratic",
        "tierInterval",
        "tierBonus",
        "wave",
        "milestoneInterval",
        "milestoneBase",
        "milestoneLinear",
        "activityRate",
        "combatGain",
        "gatheringGain",
        "growthRateMin"
      ],
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0,
          "title": "必要経験値の基本値"
        },
        "quadratic": {
          "type": "integer",
          "minimum": 0,
          "title": "成長度二乗の経験値係数"
        },
        "tierInterval": {
          "type": "integer",
          "minimum": 1,
          "title": "節目加算の成長度間隔"
        },
        "tierBonus": {
          "type": "integer",
          "minimum": 0,
          "title": "節目の経験値加算"
        },
        "wave": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "title": "周期的な経験値加算"
        },
        "milestoneInterval": {
          "type": "integer",
          "minimum": 1,
          "title": "大きな節目の成長度間隔"
        },
        "milestoneBase": {
          "type": "integer",
          "minimum": 0,
          "title": "大きな節目の基本加算"
        },
        "milestoneLinear": {
          "type": "integer",
          "minimum": 0,
          "title": "大きな節目の成長度係数"
        },
        "activityRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "title": "活動経験値の付与比率",
          "description": "専用式で求めた獲得経験値に、個体の成長補正と合わせて一度掛ける比率。時間経過だけでは成長しない。"
        },
        "combatGain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "perLevel"],
          "title": "討伐で獲得する経験値",
          "description": "floor(基本値 + 対象レベル係数 × 実効敵レベル)。プレイヤーの獲得EXP・EXP倍率・レベル差補正は参照しない。対象レベル2147483647でも計算結果を9223372036854775807未満にする。",
          "allOf": [{"anyOf": [
            {"properties": {"base": {"exclusiveMinimum": 0}}},
            {"properties": {"perLevel": {"exclusiveMinimum": 0}}}
          ]}],
          "properties": {
            "base": {"type": "number", "minimum": 0, "default": 50, "title": "討伐経験値の基本値"},
            "perLevel": {"type": "number", "minimum": 0, "default": 25, "title": "敵レベルごとの経験値係数"}
          }
        },
        "gatheringGain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "perLevel"],
          "title": "採集で獲得する経験値",
          "description": "floor(基本値 + 対象レベル係数 × 採集マスターのlevel)。プレイヤーの獲得EXP・EXP倍率・レベル差補正は参照しない。対象レベル2147483647でも計算結果を9223372036854775807未満にする。",
          "allOf": [{"anyOf": [
            {"properties": {"base": {"exclusiveMinimum": 0}}},
            {"properties": {"perLevel": {"exclusiveMinimum": 0}}}
          ]}],
          "properties": {
            "base": {"type": "number", "minimum": 0, "default": 20, "title": "採集経験値の基本値"},
            "perLevel": {"type": "number", "minimum": 0, "default": 10, "title": "採集レベルごとの経験値係数"}
          }
        },
        "growthRateMin": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "default": 0.25,
          "title": "個体の成長補正の下限",
          "description": "5つの基礎能力が種族の全ティア上限に達した個体のEXP倍率。基礎能力が低いほど1へ近づく。潜在能力・育成済み能力値は計算に含めない。"
        }
      },
      "title": "必要経験値・獲得経験値・成長補正"
    },
    "species": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "entityType",
          "eggItemId",
          "petItemId",
          "dropWeight",
          "names",
          "sizeMin",
          "sizeMax",
          "hatchMaterials",
          "stats",
          "skills",
          "basicAttack"
        ],
        "properties": {
          "id": {
            "enum": [
              "wolf",
              "cat",
              "chicken"
            ],
            "title": "ID"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "title": "種類の表示名"
          },
          "entityType": {
            "enum": [
              "WOLF",
              "CAT",
              "CHICKEN"
            ],
            "title": "Minecraftのエンティティ種別"
          },
          "eggItemId": {
            "type": "string",
            "pattern": "^item:[0-9]{2}[a-z][0-9]{5}$",
            "title": "卵のアイテム参照",
            "description": "item:参照。81.pet_eggカテゴリの数量1個体アイテム。"
          },
          "petItemId": {
            "type": "string",
            "pattern": "^item:[0-9]{2}[a-z][0-9]{5}$",
            "title": "孵化後ペットのアイテム参照",
            "description": "item:参照。80.petカテゴリの数量1個体アイテム。"
          },
          "dropWeight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "title": "卵の種類抽選重み"
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 50,
            "uniqueItems": true,
            "title": "ランダム名前候補",
            "description": "孵化時に名前を抽選する。50個以上、種類内で重複しない。"
          },
          "sizeMin": {
            "type": "number",
            "minimum": 0.0625,
            "maximum": 16,
            "title": "基礎個体サイズの下限",
            "description": "孵化時に抽選する基礎個体サイズの下限。能力へ補正を付けない。"
          },
          "sizeMax": {
            "type": "number",
            "minimum": 0.0625,
            "maximum": 16,
            "title": "基礎個体サイズの上限",
            "description": "孵化時に抽選する基礎個体サイズの上限。下限以上にする。"
          },
          "hatchMaterials": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemId",
                "quantity"
              ],
              "properties": {
                "itemId": {
                  "type": "string",
                  "pattern": "^item:[0-9]{2}[a-z][0-9]{5}$",
                  "title": "素材のアイテム参照",
                  "description": "item:参照。素材カテゴリのマスターを指定する。"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "title": "必要数量"
                }
              }
            },
            "minItems": 1,
            "title": "孵化で消費する素材"
          },
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "VITALITY",
              "POWER",
              "DEFENSE",
              "EVASION",
              "SUPPORT"
            ],
            "properties": {
              "VITALITY": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tiers",
                  "valueWeightPower",
                  "growthPerLevel",
                  "inheritanceMin",
                  "inheritanceMax",
                  "scale"
                ],
                "properties": {
                  "tiers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "tier",
                        "min",
                        "max",
                        "weight"
                      ],
                      "properties": {
                        "tier": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10,
                          "title": "ティア"
                        },
                        "min": {
                          "type": "integer",
                          "minimum": 0,
                          "title": "個体値の下限"
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 0,
                          "title": "個体値の上限"
                        },
                        "weight": {
                          "type": "number",
                          "minimum": 0,
                          "title": "抽選重み",
                          "description": "候補の相対的な抽選重み。"
                        }
                      }
                    },
                    "minItems": 11,
                    "maxItems": 11,
                    "title": "個体値のティア定義",
                    "description": "T0〜T10の11段階。範囲を重複させず上位ほど高い値にする。"
                  },
                  "valueWeightPower": {
                    "type": "number",
                    "minimum": 0,
                    "title": "低い個体値の抽選重み指数",
                    "description": "整数値vの抽選重みは(max−v+1)^指数。低い値ほど出やすい。"
                  },
                  "growthPerLevel": {
                    "type": "number",
                    "minimum": 0,
                    "title": "成長度ごとの能力増分",
                    "description": "現在値=基礎個体値+増分×(成長度−1)×潜在倍率。"
                  },
                  "inheritanceMin": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "title": "主人からの継承係数の下限",
                    "description": "主人の参照ステータスへの係数。個体値と1対1の百分率にはしない。"
                  },
                  "inheritanceMax": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "title": "主人からの継承係数の上限",
                    "description": "継承係数の上限。下限以上にする。"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "title": "継承係数の飽和定数",
                    "description": "個体能力/(scale+個体能力)による飽和式の正の調整定数。"
                  }
                },
                "title": "生命力"
              },
              "POWER": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tiers",
                  "valueWeightPower",
                  "growthPerLevel",
                  "inheritanceMin",
                  "inheritanceMax",
                  "scale"
                ],
                "properties": {
                  "tiers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "tier",
                        "min",
                        "max",
                        "weight"
                      ],
                      "properties": {
                        "tier": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10,
                          "title": "ティア"
                        },
                        "min": {
                          "type": "integer",
                          "minimum": 0,
                          "title": "個体値の下限"
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 0,
                          "title": "個体値の上限"
                        },
                        "weight": {
                          "type": "number",
                          "minimum": 0,
                          "title": "抽選重み",
                          "description": "候補の相対的な抽選重み。"
                        }
                      }
                    },
                    "minItems": 11,
                    "maxItems": 11,
                    "title": "個体値のティア定義",
                    "description": "T0〜T10の11段階。範囲を重複させず上位ほど高い値にする。"
                  },
                  "valueWeightPower": {
                    "type": "number",
                    "minimum": 0,
                    "title": "低い個体値の抽選重み指数",
                    "description": "整数値vの抽選重みは(max−v+1)^指数。低い値ほど出やすい。"
                  },
                  "growthPerLevel": {
                    "type": "number",
                    "minimum": 0,
                    "title": "成長度ごとの能力増分",
                    "description": "現在値=基礎個体値+増分×(成長度−1)×潜在倍率。"
                  },
                  "inheritanceMin": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "title": "主人からの継承係数の下限",
                    "description": "主人の参照ステータスへの係数。個体値と1対1の百分率にはしない。"
                  },
                  "inheritanceMax": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "title": "主人からの継承係数の上限",
                    "description": "継承係数の上限。下限以上にする。"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "title": "継承係数の飽和定数",
                    "description": "個体能力/(scale+個体能力)による飽和式の正の調整定数。"
                  }
                },
                "title": "攻撃力"
              },
              "DEFENSE": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tiers",
                  "valueWeightPower",
                  "growthPerLevel",
                  "inheritanceMin",
                  "inheritanceMax",
                  "scale"
                ],
                "properties": {
                  "tiers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "tier",
                        "min",
                        "max",
                        "weight"
                      ],
                      "properties": {
                        "tier": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10,
                          "title": "ティア"
                        },
                        "min": {
                          "type": "integer",
                          "minimum": 0,
                          "title": "個体値の下限"
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 0,
                          "title": "個体値の上限"
                        },
                        "weight": {
                          "type": "number",
                          "minimum": 0,
                          "title": "抽選重み",
                          "description": "候補の相対的な抽選重み。"
                        }
                      }
                    },
                    "minItems": 11,
                    "maxItems": 11,
                    "title": "個体値のティア定義",
                    "description": "T0〜T10の11段階。範囲を重複させず上位ほど高い値にする。"
                  },
                  "valueWeightPower": {
                    "type": "number",
                    "minimum": 0,
                    "title": "低い個体値の抽選重み指数",
                    "description": "整数値vの抽選重みは(max−v+1)^指数。低い値ほど出やすい。"
                  },
                  "growthPerLevel": {
                    "type": "number",
                    "minimum": 0,
                    "title": "成長度ごとの能力増分",
                    "description": "現在値=基礎個体値+増分×(成長度−1)×潜在倍率。"
                  },
                  "inheritanceMin": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "title": "主人からの継承係数の下限",
                    "description": "主人の参照ステータスへの係数。個体値と1対1の百分率にはしない。"
                  },
                  "inheritanceMax": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "title": "主人からの継承係数の上限",
