allowBlockBreak: false
allowBlockPlace: false
allowMobSpawn: false
showSpawnParticle: false
spawnLocation:
  # 後から指定されるプレイヤーのスポーン座標を設定する。
  x: null
  y: null
  z: null
  yaw: 0.0
  pitch: 0.0
description: "月蝕の綴り魔女 セレネアと戦うインスタンス式のボスフィールド。"
