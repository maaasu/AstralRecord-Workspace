{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astralrecord.local/schemas/status-types.v1.schema.json",
  "title": "AstralRecord Status Type Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "categories", "statuses"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "description", "category"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
          },
          "suffix": {
            "type": "string",
            "default": ""
          },
          "decimalPlaces": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "default": 0
          },
          "supportsRange": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}
